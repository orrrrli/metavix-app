exports[`MetasScreen — DOM snapshots > estado de carga 1`] = `"<div class="flex flex-col items-center justify-center py-20" style="color: var(--mut);"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-loader-circle h-8 w-8 animate-spin mb-4" aria-hidden="true"><path d="M21 12a9 9 0 1 1-6.219-8.56"></path></svg><p>Cargando tus datos clínicos...</p></div>"`;

exports[`MetasScreen — DOM snapshots > paciente embarazada, sin evaluar 1`] = `"<div class="max-w-4xl mx-auto pb-12 animate-in fade-in duration-500"><div class="flex items-center justify-between gap-4 mb-4"><div><h1 class="text-2xl font-extrabold tracking-tight" style="color: var(--text);">Mis Metas de Control</h1><p class="text-sm mt-1.5" style="color: var(--mut);">Lo más importante primero, para que sepas qué hacer hoy.</p></div><span class="inline-flex items-center gap-1.5 rounded-full px-3.5 py-1.5 text-xs font-bold shrink-0" style="background: var(--nav-active-bg); color: var(--nav-active);"><span class="size-1.5 rounded-full shrink-0" style="background: var(--nav-active);"></span>Embarazo · metas ajustadas</span></div><div role="status" class="mb-6 flex items-start gap-3 p-4 rounded-lg border-2" style="background: var(--info-bg); border-color: var(--info);"><div class="flex items-center justify-center size-9 rounded-full shrink-0" style="background: var(--info);"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-info size-5" style="color: #fff;" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg></div><div class="flex-1 pt-0.5"><p class="text-base font-semibold" style="color: var(--text);">Estás en modo embarazo</p><p class="text-sm mt-1" style="color: var(--text);">Las metas clínicas que ves están ajustadas para el embarazo. Las metas personalizadas que tenías antes quedan en pausa y se reactivarán cuando se desactive el embarazo.</p></div></div><section class="flex flex-col items-center text-center rounded-[20px] px-6 py-11 sm:px-10" style="background: var(--card); border: 1.5px solid; border-width: var(--card-bd); border-style: var(--card-bd); border-color: var(--card-bd);"><div class="flex items-center justify-center size-14 rounded-full mb-5" style="background: var(--ok-bg);"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="var(--ok)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12h4l2 8 4-16 2 8h6"></path></svg></div><h2 class="font-display text-xl font-extrabold mb-2.5" style="color: var(--text);">Ya tienes datos suficientes para evaluar</h2><p class="text-sm mb-6 max-w-md leading-relaxed" style="color: var(--mut);">No necesitas registrar nada nuevo. Usaremos automáticamente los últimos valores que ya tienes registrados y los compararemos contra tus metas clínicas.</p><div class="flex flex-wrap justify-center gap-2 mb-7"><span class="rounded-full px-3.5 py-1.5 text-xs font-semibold" style="background: var(--ph); color: var(--mut);">0 de 16 parámetros con datos recientes</span></div><button type="button" tabindex="0" data-slot="button" class="group/button inline-flex shrink-0 items-center justify-center rounded-lg border border-transparent bg-clip-padding font-medium whitespace-nowrap transition-all outline-none select-none focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/50 active:not-aria-[haspopup]:translate-y-px disabled:pointer-events-none disabled:opacity-50 aria-invalid:border-destructive aria-invalid:ring-3 aria-invalid:ring-destructive/20 dark:aria-invalid:border-destructive/50 dark:aria-invalid:ring-destructive/40 [&amp;_svg]:pointer-events-none [&amp;_svg]:shrink-0 [&amp;_svg:not([class*='size-'])]:size-4 bg-primary text-primary-foreground [a]:hover:bg-primary/80 gap-1.5 has-data-[icon=inline-end]:pr-2 has-data-[icon=inline-start]:pl-2 h-14 px-11 text-base shadow-md">Evaluar mis metas</button></section><div class="mt-12 pt-6 border-t text-center text-sm" style="border-color: var(--bd); color: var(--mut);"><p>Valores de referencia basados en los estándares de atención médica de la ADA (Standards of Care 2026).</p></div></div>"`;

exports[`MetasScreen — DOM snapshots > paciente normal, sin evaluar 1`] = `"<div class="max-w-4xl mx-auto pb-12 animate-in fade-in duration-500"><div class="flex items-center justify-between gap-4 mb-4"><div><h1 class="text-2xl font-extrabold tracking-tight" style="color: var(--text);">Mis Metas de Control</h1><p class="text-sm mt-1.5" style="color: var(--mut);">Lo más importante primero, para que sepas qué hacer hoy.</p></div></div><section class="flex flex-col items-center text-center rounded-[20px] px-6 py-11 sm:px-10" style="background: var(--card); border: 1.5px solid; border-width: var(--card-bd); border-style: var(--card-bd); border-color: var(--card-bd);"><div class="flex items-center justify-center size-14 rounded-full mb-5" style="background: var(--ok-bg);"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="var(--ok)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12h4l2 8 4-16 2 8h6"></path></svg></div><h2 class="font-display text-xl font-extrabold mb-2.5" style="color: var(--text);">Ya tienes datos suficientes para evaluar</h2><p class="text-sm mb-6 max-w-md leading-relaxed" style="color: var(--mut);">No necesitas registrar nada nuevo. Usaremos automáticamente los últimos valores que ya tienes registrados y los compararemos contra tus metas clínicas.</p><div class="flex flex-wrap justify-center gap-2 mb-7"><span class="rounded-full px-3.5 py-1.5 text-xs font-semibold" style="background: var(--ph); color: var(--mut);">0 de 16 parámetros con datos recientes</span></div><button type="button" tabindex="0" data-slot="button" class="group/button inline-flex shrink-0 items-center justify-center rounded-lg border border-transparent bg-clip-padding font-medium whitespace-nowrap transition-all outline-none select-none focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/50 active:not-aria-[haspopup]:translate-y-px disabled:pointer-events-none disabled:opacity-50 aria-invalid:border-destructive aria-invalid:ring-3 aria-invalid:ring-destructive/20 dark:aria-invalid:border-destructive/50 dark:aria-invalid:ring-destructive/40 [&amp;_svg]:pointer-events-none [&amp;_svg]:shrink-0 [&amp;_svg:not([class*='size-'])]:size-4 bg-primary text-primary-foreground [a]:hover:bg-primary/80 gap-1.5 has-data-[icon=inline-end]:pr-2 has-data-[icon=inline-start]:pl-2 h-14 px-11 text-base shadow-md">Evaluar mis metas</button></section><div class="mt-12 pt-6 border-t text-center text-sm" style="border-color: var(--bd); color: var(--mut);"><p>Valores de referencia basados en los estándares de atención médica de la ADA (Standards of Care 2026).</p></div></div>"`;

exports[`MetasScreen — DOM snapshots > post-evaluación con hero, detalle y CkdStageExplainer 1`] = `"<div class="max-w-4xl mx-auto pb-12 animate-in fade-in duration-500"><div class="flex items-center justify-between gap-4 mb-4"><div><h1 class="text-2xl font-extrabold tracking-tight" style="color: var(--text);">Mis Metas de Control</h1><p class="text-sm mt-1.5" style="color: var(--mut);">Lo más importante primero, para que sepas qué hacer hoy.</p></div></div><div id="resumen-metas" class="space-y-6"><p class="text-xs" style="color: var(--soft);">Evaluación: 13 jul 2026, 12:00 a.m.</p><div class="flex items-center gap-6 rounded-xl p-5 sm:p-6" style="background: var(--card); border: 1.5px solid; box-shadow: 0 12px 30px rgba(20,40,30,.05); border-width: var(--card-bd); border-style: var(--card-bd); border-color: var(--card-bd);"><svg width="108" height="108" viewBox="0 0 108 108" class="shrink-0"><circle cx="54" cy="54" r="46" fill="none" stroke="var(--bd)" stroke-width="13"></circle><circle cx="54" cy="54" r="46" fill="none" stroke="var(--ok)" stroke-width="13" stroke-linecap="round" stroke-dasharray="289.02652413026095 289.02652413026095" transform="rotate(-90 54 54)"></circle><text x="54" y="51" text-anchor="middle" font-size="24" font-weight="800" fill="var(--text)">100%</text><text x="54" y="68" text-anchor="middle" font-size="10" fill="var(--soft)">en meta</text></svg><div><p class="text-base font-semibold mb-1.5" style="color: var(--text);">Todos tus valores evaluados están en meta.</p><p class="text-sm" style="color: var(--mut);">2 en meta · 0 por mejorar · 0 fuera de meta · 14 sin registrar</p></div></div><div class="rounded-xl p-5 sm:p-6" style="background: var(--card); border: 1.5px solid; border-width: var(--card-bd); border-style: var(--card-bd); border-color: var(--card-bd);"><div class="flex items-start gap-3 mb-4"><div class="flex items-center justify-center size-9 rounded-full shrink-0" style="background: var(--info);"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-info size-5" style="color: #fff;" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg></div><div class="flex-1"><h3 class="font-display font-semibold text-base" style="color: var(--text);">Etapa de enfermedad renal (KDIGO 2024)</h3><p class="text-sm mt-1" style="color: var(--mut);">Tu eGFR de <strong>72 ml/min/1.73m²</strong> corresponde a la <strong>G2 — Daño renal leve</strong>.</p></div></div><div class="flex flex-col gap-2"><div data-testid="ckd-stage-row" data-stage="G1" data-current="false" class="flex justify-between items-start gap-4 rounded-md border p-3" style="background: var(--card); border-color: var(--bd);"><div><p class="text-sm font-semibold" style="color: var(--text);">G1 — Función renal normal o alta</p><p class="text-xs mt-1 leading-snug" style="color: var(--text);"><span class="font-medium">Acción:</span> Función preservada. Mantener control glucémico y de presión arterial; revisión anual.</p></div><p class="text-xs shrink-0 whitespace-nowrap" style="color: var(--mut);">≥ 90 ml/min/1.73m²</p></div><div data-testid="ckd-stage-row" data-stage="G2" data-current="true" class="flex justify-between items-start gap-4 rounded-md border p-3" style="background: var(--ok-bg); border-color: var(--ok);"><div><p class="text-sm font-semibold" style="color: var(--ok);">G2 — Daño renal leve</p><p class="text-xs mt-1 leading-snug" style="color: var(--text);"><span class="font-medium">Acción:</span> Daño leve con filtrado aún normal. Optimizar control de glucemia y PA; evaluar causa si hay proteinuria.</p></div><p class="text-xs shrink-0 whitespace-nowrap" style="color: var(--ok);">60–89 ml/min/1.73m²</p></div><div data-testid="ckd-stage-row" data-stage="G3a" data-current="false" class="flex justify-between items-start gap-4 rounded-md border p-3" style="background: var(--card); border-color: var(--bd);"><div><p class="text-sm font-semibold" style="color: var(--text);">G3a — Daño renal leve a moderado</p><p class="text-xs mt-1 leading-snug" style="color: var(--text);"><span class="font-medium">Acción:</span> Requiere nefroprotección activa: iSGLT2, control estricto de PA y glucemia. Vigilancia cada 6 meses.</p></div><p class="text-xs shrink-0 whitespace-nowrap" style="color: var(--mut);">45–59 ml/min/1.73m²</p></div><div data-testid="ckd-stage-row" data-stage="G3b" data-current="false" class="flex justify-between items-start gap-4 rounded-md border p-3" style="background: var(--card); border-color: var(--bd);"><div><p class="text-sm font-semibold" style="color: var(--text);">G3b — Daño renal moderado a severo</p><p class="text-xs mt-1 leading-snug" style="color: var(--text);"><span class="font-medium">Acción:</span> Valorar derivación a nefrología. Ajustar dosis de medicamentos nefrotóxicos; mantener iSGLT2 si se tolera.</p></div><p class="text-xs shrink-0 whitespace-nowrap" style="color: var(--mut);">30–44 ml/min/1.73m²</p></div><div data-testid="ckd-stage-row" data-stage="G4" data-current="false" class="flex justify-between items-start gap-4 rounded-md border p-3" style="background: var(--card); border-color: var(--bd);"><div><p class="text-sm font-semibold" style="color: var(--text);">G4 — Daño renal severo</p><p class="text-xs mt-1 leading-snug" style="color: var(--text);"><span class="font-medium">Acción:</span> Manejo conjunto con nefrología. Preparar acceso vascular para posible terapia de reemplazo renal.</p></div><p class="text-xs shrink-0 whitespace-nowrap" style="color: var(--mut);">15–29 ml/min/1.73m²</p></div><div data-testid="ckd-stage-row" data-stage="G5" data-current="false" class="flex justify-between items-start gap-4 rounded-md border p-3" style="background: var(--card); border-color: var(--bd);"><div><p class="text-sm font-semibold" style="color: var(--text);">G5 — Falla renal</p><p class="text-xs mt-1 leading-snug" style="color: var(--text);"><span class="font-medium">Acción:</span> Terapia de reemplazo renal (diálisis o trasplante). Seguimiento conjunto con nefrología.</p></div><p class="text-xs shrink-0 whitespace-nowrap" style="color: var(--mut);">&lt; 15 ml/min/1.73m²</p></div></div></div><div><h2 class="flex items-center gap-2 text-sm font-bold mb-2.5" style="color: var(--text);"><span class="size-2.5 rounded-full shrink-0" style="background: var(--ok);"></span>Vas bien en esto</h2><div class="flex flex-col gap-2.5"><div class="flex items-center gap-4 rounded-xl p-4" style="background: var(--card); border: 1.5px solid; border-width: var(--ok-bg); border-style: var(--ok-bg); border-color: var(--ok-bg);"><div class="flex-1 min-w-0"><div class="flex items-baseline gap-2 flex-wrap"><span class="text-sm font-semibold" style="color: var(--text);">HbA1c</span><span class="text-xl font-bold" style="color: var(--ok);">6.4 %</span></div><p class="text-xs mt-1" style="color: var(--mut);">&lt; 7.0%</p></div><span class="text-xs font-bold rounded-full px-3 py-1.5 whitespace-nowrap" style="color: var(--ok); background: var(--ok-bg);">En meta</span></div><div class="flex items-center gap-4 rounded-xl p-4" style="background: var(--card); border: 1.5px solid; border-width: var(--ok-bg); border-style: var(--ok-bg); border-color: var(--ok-bg);"><div class="flex-1 min-w-0"><div class="flex items-baseline gap-2 flex-wrap"><span class="text-sm font-semibold" style="color: var(--text);">Tasa de filtración glomerular estimada (eGFR)</span><span class="text-xl font-bold" style="color: var(--ok);">72 ml/min/1.73m²</span></div><p class="text-xs mt-1" style="color: var(--mut);">≥ 60 ml/min/1.73m²</p></div><span class="text-xs font-bold rounded-full px-3 py-1.5 whitespace-nowrap" style="color: var(--ok); background: var(--ok-bg);">En meta</span></div></div></div><div><h2 class="flex items-center gap-2 text-sm font-bold mb-2.5" style="color: var(--text);"><span class="size-2.5 rounded-full shrink-0" style="background: var(--soft);"></span>Te faltan registros</h2><div class="flex flex-col gap-2"><div class="flex items-center gap-3.5 rounded-xl p-3" style="background: var(--card); border: 1.5px dashed; border-width: var(--bd); border-style: var(--bd); border-color: var(--bd);"><span class="flex-1 text-sm" style="color: var(--mut);">Glucosa en ayuno — sin datos recientes</span></div><div class="flex items-center gap-3.5 rounded-xl p-3" style="background: var(--card); border: 1.5px dashed; border-width: var(--bd); border-style: var(--bd); border-color: var(--bd);"><span class="flex-1 text-sm" style="color: var(--mut);">Glucosa postprandial (1 h) — sin datos recientes</span></div><div class="flex items-center gap-3.5 rounded-xl p-3" style="background: var(--card); border: 1.5px dashed; border-width: var(--bd); border-style: var(--bd); border-color: var(--bd);"><span class="flex-1 text-sm" style="color: var(--mut);">Glucosa postprandial (2 h) — sin datos recientes</span></div><div class="flex items-center gap-3.5 rounded-xl p-3" style="background: var(--card); border: 1.5px dashed; border-width: var(--bd); border-style: var(--bd); border-color: var(--bd);"><span class="flex-1 text-sm" style="color: var(--mut);">Presión arterial sistólica — sin datos recientes</span></div><div class="flex items-center gap-3.5 rounded-xl p-3" style="background: var(--card); border: 1.5px dashed; border-width: var(--bd); border-style: var(--bd); border-color: var(--bd);"><span class="flex-1 text-sm" style="color: var(--mut);">Presión arterial diastólica — sin datos recientes</span></div><div class="flex items-center gap-3.5 rounded-xl p-3" style="background: var(--card); border: 1.5px dashed; border-width: var(--bd); border-style: var(--bd); border-color: var(--bd);"><span class="flex-1 text-sm" style="color: var(--mut);">Frecuencia cardíaca — sin datos recientes</span></div><div class="flex items-center gap-3.5 rounded-xl p-3" style="background: var(--card); border: 1.5px dashed; border-width: var(--bd); border-style: var(--bd); border-color: var(--bd);"><span class="flex-1 text-sm" style="color: var(--mut);">Índice de Masa Corporal (IMC) — sin datos recientes</span></div><div class="flex items-center gap-3.5 rounded-xl p-3" style="background: var(--card); border: 1.5px dashed; border-width: var(--bd); border-style: var(--bd); border-color: var(--bd);"><span class="flex-1 text-sm" style="color: var(--mut);">Colesterol LDL — sin datos recientes</span></div><div class="flex items-center gap-3.5 rounded-xl p-3" style="background: var(--card); border: 1.5px dashed; border-width: var(--bd); border-style: var(--bd); border-color: var(--bd);"><span class="flex-1 text-sm" style="color: var(--mut);">Colesterol HDL — sin datos recientes</span></div><div class="flex items-center gap-3.5 rounded-xl p-3" style="background: var(--card); border: 1.5px dashed; border-width: var(--bd); border-style: var(--bd); border-color: var(--bd);"><span class="flex-1 text-sm" style="color: var(--mut);">Colesterol total — sin datos recientes</span></div><div class="flex items-center gap-3.5 rounded-xl p-3" style="background: var(--card); border: 1.5px dashed; border-width: var(--bd); border-style: var(--bd); border-color: var(--bd);"><span class="flex-1 text-sm" style="color: var(--mut);">Triglicéridos — sin datos recientes</span></div><div class="flex items-center gap-3.5 rounded-xl p-3" style="background: var(--card); border: 1.5px dashed; border-width: var(--bd); border-style: var(--bd); border-color: var(--bd);"><span class="flex-1 text-sm" style="color: var(--mut);">Creatinina sérica — sin datos recientes</span></div><div class="flex items-center gap-3.5 rounded-xl p-3" style="background: var(--card); border: 1.5px dashed; border-width: var(--bd); border-style: var(--bd); border-color: var(--bd);"><span class="flex-1 text-sm" style="color: var(--mut);">Nitrógeno ureico en sangre (BUN) — sin datos recientes</span></div><div class="flex items-center gap-3.5 rounded-xl p-3" style="background: var(--card); border: 1.5px dashed; border-width: var(--bd); border-style: var(--bd); border-color: var(--bd);"><span class="flex-1 text-sm" style="color: var(--mut);">Perímetro de cintura — sin datos recientes</span></div></div></div><details class="group"><summary class="flex items-center gap-2 text-xs font-bold cursor-pointer list-none py-2.5" style="color: var(--mut);"><span class="group-open:rotate-90 transition-transform">▸</span>Ver los 16 parámetros y sus metas clínicas completas</summary><div class="mt-2.5"><div class="rounded-xl p-5 sm:p-6" style="background: var(--card); border: 1.5px solid; border-width: var(--card-bd); border-style: var(--card-bd); border-color: var(--card-bd);"><h3 class="font-display font-semibold text-base" style="color: var(--text);">Evaluación de metas</h3><p class="text-xs mt-1 mb-4" style="color: var(--mut);">Evaluación: 13 jul 2026, 12:00 a.m.</p><div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 mt-4"><div class="rounded-lg p-4 border" style="background: var(--ok-bg); border-color: var(--ok);"><div class="text-sm font-semibold mb-1.5" style="color: var(--text);">HbA1c</div><div class="flex items-baseline gap-1 mb-1.5"><span class="text-lg font-bold" style="color: var(--ok);">6.4</span><span class="text-xs" style="color: var(--soft);">%</span></div><div class="text-xs font-semibold tracking-wide" style="color: var(--ok);">EN META</div></div><div class="rounded-lg p-4 border" style="background: var(--ph); border-color: var(--bd);"><div class="text-sm font-semibold mb-1.5" style="color: var(--text);">Glucosa en ayuno</div><div class="flex items-baseline gap-1 mb-1.5"><span class="text-lg font-bold" style="color: var(--soft);">—</span><span class="text-xs" style="color: var(--soft);">mg/dL</span></div><div class="text-xs font-semibold tracking-wide" style="color: var(--soft);">SIN DATOS</div></div><div class="rounded-lg p-4 border" style="background: var(--ph); border-color: var(--bd);"><div class="text-sm font-semibold mb-1.5" style="color: var(--text);">Glucosa postprandial (1 h)</div><div class="flex items-baseline gap-1 mb-1.5"><span class="text-lg font-bold" style="color: var(--soft);">—</span><span class="text-xs" style="color: var(--soft);">mg/dL</span></div><div class="text-xs font-semibold tracking-wide" style="color: var(--soft);">SIN DATOS</div></div><div class="rounded-lg p-4 border" style="background: var(--ph); border-color: var(--bd);"><div class="text-sm font-semibold mb-1.5" style="color: var(--text);">Glucosa postprandial (2 h)</div><div class="flex items-baseline gap-1 mb-1.5"><span class="text-lg font-bold" style="color: var(--soft);">—</span><span class="text-xs" style="color: var(--soft);">mg/dL</span></div><div class="text-xs font-semibold tracking-wide" style="color: var(--soft);">SIN DATOS</div></div><div class="rounded-lg p-4 border" style="background: var(--ph); border-color: var(--bd);"><div class="text-sm font-semibold mb-1.5" style="color: var(--text);">Presión arterial sistólica</div><div class="flex items-baseline gap-1 mb-1.5"><span class="text-lg font-bold" style="color: var(--soft);">—</span><span class="text-xs" style="color: var(--soft);">mmHg</span></div><div class="text-xs font-semibold tracking-wide" style="color: var(--soft);">SIN DATOS</div></div><div class="rounded-lg p-4 border" style="background: var(--ph); border-color: var(--bd);"><div class="text-sm font-semibold mb-1.5" style="color: var(--text);">Presión arterial diastólica</div><div class="flex items-baseline gap-1 mb-1.5"><span class="text-lg font-bold" style="color: var(--soft);">—</span><span class="text-xs" style="color: var(--soft);">mmHg</span></div><div class="text-xs font-semibold tracking-wide" style="color: var(--soft);">SIN DATOS</div></div><div class="rounded-lg p-4 border" style="background: var(--ph); border-color: var(--bd);"><div class="text-sm font-semibold mb-1.5" style="color: var(--text);">Frecuencia cardíaca</div><div class="flex items-baseline gap-1 mb-1.5"><span class="text-lg font-bold" style="color: var(--soft);">—</span><span class="text-xs" style="color: var(--soft);">lat/min</span></div><div class="text-xs font-semibold tracking-wide" style="color: var(--soft);">SIN DATOS</div></div><div class="rounded-lg p-4 border" style="background: var(--ph); border-color: var(--bd);"><div class="text-sm font-semibold mb-1.5" style="color: var(--text);">Índice de Masa Corporal (IMC)</div><div class="flex items-baseline gap-1 mb-1.5"><span class="text-lg font-bold" style="color: var(--soft);">—</span><span class="text-xs" style="color: var(--soft);">kg/m²</span></div><div class="text-xs font-semibold tracking-wide" style="color: var(--soft);">SIN DATOS</div></div><div class="rounded-lg p-4 border" style="background: var(--ph); border-color: var(--bd);"><div class="text-sm font-semibold mb-1.5" style="color: var(--text);">Colesterol LDL</div><div class="flex items-baseline gap-1 mb-1.5"><span class="text-lg font-bold" style="color: var(--soft);">—</span><span class="text-xs" style="color: var(--soft);">mg/dL</span></div><div class="text-xs font-semibold tracking-wide" style="color: var(--soft);">SIN DATOS</div></div><div class="rounded-lg p-4 border" style="background: var(--ph); border-color: var(--bd);"><div class="text-sm font-semibold mb-1.5" style="color: var(--text);">Colesterol HDL</div><div class="flex items-baseline gap-1 mb-1.5"><span class="text-lg font-bold" style="color: var(--soft);">—</span><span class="text-xs" style="color: var(--soft);">mg/dL</span></div><div class="text-xs font-semibold tracking-wide" style="color: var(--soft);">SIN DATOS</div></div><div class="rounded-lg p-4 border" style="background: var(--ph); border-color: var(--bd);"><div class="text-sm font-semibold mb-1.5" style="color: var(--text);">Colesterol total</div><div class="flex items-baseline gap-1 mb-1.5"><span class="text-lg font-bold" style="color: var(--soft);">—</span><span class="text-xs" style="color: var(--soft);">mg/dL</span></div><div class="text-xs font-semibold tracking-wide" style="color: var(--soft);">SIN DATOS</div></div><div class="rounded-lg p-4 border" style="background: var(--ph); border-color: var(--bd);"><div class="text-sm font-semibold mb-1.5" style="color: var(--text);">Triglicéridos</div><div class="flex items-baseline gap-1 mb-1.5"><span class="text-lg font-bold" style="color: var(--soft);">—</span><span class="text-xs" style="color: var(--soft);">mg/dL</span></div><div class="text-xs font-semibold tracking-wide" style="color: var(--soft);">SIN DATOS</div></div><div class="rounded-lg p-4 border" style="background: var(--ph); border-color: var(--bd);"><div class="text-sm font-semibold mb-1.5" style="color: var(--text);">Creatinina sérica</div><div class="flex items-baseline gap-1 mb-1.5"><span class="text-lg font-bold" style="color: var(--soft);">—</span><span class="text-xs" style="color: var(--soft);">mg/dL</span></div><div class="text-xs font-semibold tracking-wide" style="color: var(--soft);">SIN DATOS</div></div><div class="rounded-lg p-4 border" style="background: var(--ok-bg); border-color: var(--ok);"><div class="text-sm font-semibold mb-1.5" style="color: var(--text);">Tasa de filtración glomerular estimada (eGFR)</div><div class="flex items-baseline gap-1 mb-1.5"><span class="text-lg font-bold" style="color: var(--ok);">72</span><span class="text-xs" style="color: var(--soft);">ml/min/1.73m²</span></div><div class="text-xs font-semibold tracking-wide" style="color: var(--ok);">EN META</div></div><div class="rounded-lg p-4 border" style="background: var(--ph); border-color: var(--bd);"><div class="text-sm font-semibold mb-1.5" style="color: var(--text);">Nitrógeno ureico en sangre (BUN)</div><div class="flex items-baseline gap-1 mb-1.5"><span class="text-lg font-bold" style="color: var(--soft);">—</span><span class="text-xs" style="color: var(--soft);">mg/dL</span></div><div class="text-xs font-semibold tracking-wide" style="color: var(--soft);">SIN DATOS</div></div><div class="rounded-lg p-4 border" style="background: var(--ph); border-color: var(--bd);"><div class="text-sm font-semibold mb-1.5" style="color: var(--text);">Perímetro de cintura</div><div class="flex items-baseline gap-1 mb-1.5"><span class="text-lg font-bold" style="color: var(--soft);">—</span><span class="text-xs" style="color: var(--soft);">cm</span></div><div class="text-xs font-semibold tracking-wide" style="color: var(--soft);">SIN DATOS</div></div></div></div></div></details></div><div class="mt-12 pt-6 border-t text-center text-sm" style="border-color: var(--bd); color: var(--mut);"><p>Valores de referencia basados en los estándares de atención médica de la ADA (Standards of Care 2026).</p></div></div>"`;
