// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`MetasScreen — DOM snapshots > estado de carga 1`] = `"<div class="flex flex-col items-center justify-center py-20" style="color: var(--mut);"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-loader-circle h-8 w-8 animate-spin mb-4" aria-hidden="true"><path d="M21 12a9 9 0 1 1-6.219-8.56"></path></svg><p>Cargando tus datos clínicos...</p></div>"`;

exports[`MetasScreen — DOM snapshots > paciente embarazada, sin evaluar 1`] = `"<div class="max-w-4xl mx-auto pb-12 animate-in fade-in duration-500"><div role="status" class="mb-6 flex items-start gap-3 p-4 rounded-lg border-2" style="background: var(--info-bg); border-color: var(--info);"><div class="flex items-center justify-center size-9 rounded-full shrink-0" style="background: var(--info);"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-info size-5" style="color: #fff;" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg></div><div class="flex-1 pt-0.5"><p class="text-base font-semibold" style="color: var(--text);">Estás en modo embarazo</p><p class="text-sm mt-1" style="color: var(--text);">Las metas clínicas que ves están ajustadas para el embarazo. Las metas personalizadas que tenías antes quedan en pausa y se reactivarán cuando se desactive el embarazo.</p></div></div><p class="text-lg mb-8" style="color: var(--mut);">Tus últimos resultados disponibles han sido cargados automáticamente. Los parámetros sin datos no cuentan con registros recientes.</p><div class="space-y-4"><div class="rounded-xl p-5 sm:p-6 shadow-sm hover:border-primary/20 transition-colors" style="background: var(--card); border: 1.5px solid; border-width: var(--card-bd); border-style: var(--card-bd); border-color: var(--card-bd);"><div class="flex flex-col md:flex-row md:items-center gap-6"><div class="flex-1"><div class="flex items-center gap-3 mb-1 flex-wrap"><h4 class="font-display font-semibold text-lg" style="color: var(--text);">HbA1c</h4><span class="text-xs px-2 py-0.5 rounded font-medium" style="background: var(--ph); color: var(--mut);">ADA 2026 — diabetes</span></div><div class="flex items-center gap-2 mt-2"><span class="text-sm font-semibold uppercase tracking-widest" style="color: var(--mut);">Meta:</span><span class="font-mono font-bold px-2 py-0.5 rounded" style="background: var(--ok-bg); color: var(--ok);">&lt; 7.0%</span></div></div><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right hidden md:block w-5 h-5 shrink-0" aria-hidden="true" style="color: var(--faint);"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg><div class="flex items-center gap-4 md:w-64 shrink-0"><div class="relative flex-1 h-10 flex items-center px-3 rounded-md border" style="background: var(--ph); border-color: var(--bd);"><span class="text-sm italic" style="color: var(--mut);">Sin datos</span></div><div class="w-[14px] h-[14px] rounded-full shrink-0 shadow-sm transition-colors duration-500" style="background: var(--ph);"></div></div></div><div class="mt-4 pt-4 border-t text-sm leading-relaxed" style="border-color: var(--bd); color: var(--mut);">El principal indicador de control en diabetes. Una HbA1c menor a 7% se asocia con menor riesgo de complicaciones. La meta puede individualizarse según edad y condiciones.</div></div><div class="rounded-xl p-5 sm:p-6 shadow-sm hover:border-primary/20 transition-colors" style="background: var(--card); border: 1.5px solid; border-width: var(--card-bd); border-style: var(--card-bd); border-color: var(--card-bd);"><div class="flex flex-col md:flex-row md:items-center gap-6"><div class="flex-1"><div class="flex items-center gap-3 mb-1 flex-wrap"><h4 class="font-display font-semibold text-lg" style="color: var(--text);">Glucosa en ayuno</h4><span class="text-xs px-2 py-0.5 rounded font-medium" style="background: var(--ph); color: var(--mut);">ADA 2026 — preprandial</span></div><div class="flex items-center gap-2 mt-2"><span class="text-sm font-semibold uppercase tracking-widest" style="color: var(--mut);">Meta:</span><span class="font-mono font-bold px-2 py-0.5 rounded" style="background: var(--ok-bg); color: var(--ok);">80–130 mg/dL</span></div></div><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right hidden md:block w-5 h-5 shrink-0" aria-hidden="true" style="color: var(--faint);"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg><div class="flex items-center gap-4 md:w-64 shrink-0"><div class="relative flex-1 h-10 flex items-center px-3 rounded-md border" style="background: var(--ph); border-color: var(--bd);"><span class="text-sm italic" style="color: var(--mut);">Sin datos</span></div><div class="w-[14px] h-[14px] rounded-full shrink-0 shadow-sm transition-colors duration-500" style="background: var(--ph);"></div></div></div><div class="mt-4 pt-4 border-t text-sm leading-relaxed" style="border-color: var(--bd); color: var(--mut);">La glucosa en ayuno ideal para diabéticos es entre 80 y 130 mg/dL. Por encima de 130 sugiere ajuste de tratamiento.</div></div><div class="rounded-xl p-5 sm:p-6 shadow-sm hover:border-primary/20 transition-colors" style="background: var(--card); border: 1.5px solid; border-width: var(--card-bd); border-style: var(--card-bd); border-color: var(--card-bd);"><div class="flex flex-col md:flex-row md:items-center gap-6"><div class="flex-1"><div class="flex items-center gap-3 mb-1 flex-wrap"><h4 class="font-display font-semibold text-lg" style="color: var(--text);">Glucosa postprandial (1 h)</h4><span class="text-xs px-2 py-0.5 rounded font-medium" style="background: var(--ph); color: var(--mut);">ADA 2026 — postprandial</span></div><div class="flex items-center gap-2 mt-2"><span class="text-sm font-semibold uppercase tracking-widest" style="color: var(--mut);">Meta:</span><span class="font-mono font-bold px-2 py-0.5 rounded" style="background: var(--ok-bg); color: var(--ok);">&lt; 180 mg/dL</span></div></div><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right hidden md:block w-5 h-5 shrink-0" aria-hidden="true" style="color: var(--faint);"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg><div class="flex items-center gap-4 md:w-64 shrink-0"><div class="relative flex-1 h-10 flex items-center px-3 rounded-md border" style="background: var(--ph); border-color: var(--bd);"><span class="text-sm italic" style="color: var(--mut);">Disponible al evaluar</span></div><div class="w-[14px] h-[14px] rounded-full shrink-0 shadow-sm transition-colors duration-500" style="background: var(--ph);"></div></div></div><div class="mt-4 pt-4 border-t text-sm leading-relaxed" style="border-color: var(--bd); color: var(--mut);">Medición de glucosa una hora después de comer. Meta en diabéticos: menor a 180 mg/dL.</div></div><div class="rounded-xl p-5 sm:p-6 shadow-sm hover:border-primary/20 transition-colors" style="background: var(--card); border: 1.5px solid; border-width: var(--card-bd); border-style: var(--card-bd); border-color: var(--card-bd);"><div class="flex flex-col md:flex-row md:items-center gap-6"><div class="flex-1"><div class="flex items-center gap-3 mb-1 flex-wrap"><h4 class="font-display font-semibold text-lg" style="color: var(--text);">Glucosa postprandial (2 h)</h4><span class="text-xs px-2 py-0.5 rounded font-medium" style="background: var(--ph); color: var(--mut);">ADA 2026 — postprandial</span></div><div class="flex items-center gap-2 mt-2"><span class="text-sm font-semibold uppercase tracking-widest" style="color: var(--mut);">Meta:</span><span class="font-mono font-bold px-2 py-0.5 rounded" style="background: var(--ok-bg); color: var(--ok);">&lt; 180 mg/dL</span></div></div><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right hidden md:block w-5 h-5 shrink-0" aria-hidden="true" style="color: var(--faint);"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg><div class="flex items-center gap-4 md:w-64 shrink-0"><div class="relative flex-1 h-10 flex items-center px-3 rounded-md border" style="background: var(--ph); border-color: var(--bd);"><span class="text-sm italic" style="color: var(--mut);">Disponible al evaluar</span></div><div class="w-[14px] h-[14px] rounded-full shrink-0 shadow-sm transition-colors duration-500" style="background: var(--ph);"></div></div></div><div class="mt-4 pt-4 border-t text-sm leading-relaxed" style="border-color: var(--bd); color: var(--mut);">Medición de glucosa dos horas después de comer. Meta en diabéticos: menor a 180 mg/dL.</div></div><div class="rounded-xl p-5 sm:p-6 shadow-sm hover:border-primary/20 transition-colors" style="background: var(--card); border: 1.5px solid; border-width: var(--card-bd); border-style: var(--card-bd); border-color: var(--card-bd);"><div class="flex flex-col md:flex-row md:items-center gap-6"><div class="flex-1"><div class="flex items-center gap-3 mb-1 flex-wrap"><h4 class="font-display font-semibold text-lg" style="color: var(--text);">Presión arterial sistólica</h4><span class="text-xs px-2 py-0.5 rounded font-medium" style="background: var(--ph); color: var(--mut);">ADA 2026 — diabetes</span></div><div class="flex items-center gap-2 mt-2"><span class="text-sm font-semibold uppercase tracking-widest" style="color: var(--mut);">Meta:</span><span class="font-mono font-bold px-2 py-0.5 rounded" style="background: var(--ok-bg); color: var(--ok);">&lt; 130 mmHg</span></div></div><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right hidden md:block w-5 h-5 shrink-0" aria-hidden="true" style="color: var(--faint);"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg><div class="flex items-center gap-4 md:w-64 shrink-0"><div class="relative flex-1 h-10 flex items-center px-3 rounded-md border" style="background: var(--ph); border-color: var(--bd);"><span class="text-sm italic" style="color: var(--mut);">Sin datos</span></div><div class="w-[14px] h-[14px] rounded-full shrink-0 shadow-sm transition-colors duration-500" style="background: var(--ph);"></div></div></div><div class="mt-4 pt-4 border-t text-sm leading-relaxed" style="border-color: var(--bd); color: var(--mut);">En personas con diabetes, mantener la presión sistólica menor a 130 mmHg reduce el riesgo de infarto, accidente vascular y nefropatía.</div></div><div class="rounded-xl p-5 sm:p-6 shadow-sm hover:border-primary/20 transition-colors" style="background: var(--card); border: 1.5px solid; border-width: var(--card-bd); border-style: var(--card-bd); border-color: var(--card-bd);"><div class="flex flex-col md:flex-row md:items-center gap-6"><div class="flex-1"><div class="flex items-center gap-3 mb-1 flex-wrap"><h4 class="font-display font-semibold text-lg" style="color: var(--text);">Presión arterial diastólica</h4><span class="text-xs px-2 py-0.5 rounded font-medium" style="background: var(--ph); color: var(--mut);">ADA 2026 — diabetes</span></div><div class="flex items-center gap-2 mt-2"><span class="text-sm font-semibold uppercase tracking-widest" style="color: var(--mut);">Meta:</span><span class="font-mono font-bold px-2 py-0.5 rounded" style="background: var(--ok-bg); color: var(--ok);">&lt; 80 mmHg</span></div></div><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right hidden md:block w-5 h-5 shrink-0" aria-hidden="true" style="color: var(--faint);"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg><div class="flex items-center gap-4 md:w-64 shrink-0"><div class="relative flex-1 h-10 flex items-center px-3 rounded-md border" style="background: var(--ph); border-color: var(--bd);"><span class="text-sm italic" style="color: var(--mut);">Sin datos</span></div><div class="w-[14px] h-[14px] rounded-full shrink-0 shadow-sm transition-colors duration-500" style="background: var(--ph);"></div></div></div><div class="mt-4 pt-4 border-t text-sm leading-relaxed" style="border-color: var(--bd); color: var(--mut);">En personas con diabetes, mantener la presión diastólica menor a 80 mmHg reduce el riesgo cardiovascular y renal.</div></div><div class="rounded-xl p-5 sm:p-6 shadow-sm hover:border-primary/20 transition-colors" style="background: var(--card); border: 1.5px solid; border-width: var(--card-bd); border-style: var(--card-bd); border-color: var(--card-bd);"><div class="flex flex-col md:flex-row md:items-center gap-6"><div class="flex-1"><div class="flex items-center gap-3 mb-1 flex-wrap"><h4 class="font-display font-semibold text-lg" style="color: var(--text);">Frecuencia cardíaca</h4><span class="text-xs px-2 py-0.5 rounded font-medium" style="background: var(--ph); color: var(--mut);">Rango normal</span></div><div class="flex items-center gap-2 mt-2"><span class="text-sm font-semibold uppercase tracking-widest" style="color: var(--mut);">Meta:</span><span class="font-mono font-bold px-2 py-0.5 rounded" style="background: var(--ok-bg); color: var(--ok);">60–100 lat/min</span></div></div><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right hidden md:block w-5 h-5 shrink-0" aria-hidden="true" style="color: var(--faint);"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg><div class="flex items-center gap-4 md:w-64 shrink-0"><div class="relative flex-1 h-10 flex items-center px-3 rounded-md border" style="background: var(--ph); border-color: var(--bd);"><span class="text-sm italic" style="color: var(--mut);">Sin datos</span></div><div class="w-[14px] h-[14px] rounded-full shrink-0 shadow-sm transition-colors duration-500" style="background: var(--ph);"></div></div></div><div class="mt-4 pt-4 border-t text-sm leading-relaxed" style="border-color: var(--bd); color: var(--mut);">Frecuencia cardíaca en reposo. Valores fuera de 60–100 lat/min requieren evaluación clínica.</div></div><div class="rounded-xl p-5 sm:p-6 shadow-sm hover:border-primary/20 transition-colors" style="background: var(--card); border: 1.5px solid; border-width: var(--card-bd); border-style: var(--card-bd); border-color: var(--card-bd);"><div class="flex flex-col md:flex-row md:items-center gap-6"><div class="flex-1"><div class="flex items-center gap-3 mb-1 flex-wrap"><h4 class="font-display font-semibold text-lg" style="color: var(--text);">Índice de Masa Corporal (IMC)</h4><span class="text-xs px-2 py-0.5 rounded font-medium" style="background: var(--ph); color: var(--mut);">Rango saludable</span></div><div class="flex items-center gap-2 mt-2"><span class="text-sm font-semibold uppercase tracking-widest" style="color: var(--mut);">Meta:</span><span class="font-mono font-bold px-2 py-0.5 rounded" style="background: var(--ok-bg); color: var(--ok);">18.5–24.9</span></div></div><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right hidden md:block w-5 h-5 shrink-0" aria-hidden="true" style="color: var(--faint);"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg><div class="flex items-center gap-4 md:w-64 shrink-0"><div class="relative flex-1 h-10 flex items-center px-3 rounded-md border" style="background: var(--ph); border-color: var(--bd);"><span class="text-sm italic" style="color: var(--mut);">Sin datos</span></div><div class="w-[14px] h-[14px] rounded-full shrink-0 shadow-sm transition-colors duration-500" style="background: var(--ph);"></div></div></div><div class="mt-4 pt-4 border-t text-sm leading-relaxed" style="border-color: var(--bd); color: var(--mut);">El IMC se calcula con peso y estatura. Un peso saludable mejora el control glucémico y reduce la dosis de medicamentos necesaria.</div></div><div class="rounded-xl p-5 sm:p-6 shadow-sm hover:border-primary/20 transition-colors" style="background: var(--card); border: 1.5px solid; border-width: var(--card-bd); border-style: var(--card-bd); border-color: var(--card-bd);"><div class="flex flex-col md:flex-row md:items-center gap-6"><div class="flex-1"><div class="flex items-center gap-3 mb-1 flex-wrap"><h4 class="font-display font-semibold text-lg" style="color: var(--text);">Colesterol LDL</h4><span class="text-xs px-2 py-0.5 rounded font-medium" style="background: var(--ph); color: var(--mut);">ADA 2026 — diabetes</span></div><div class="flex items-center gap-2 mt-2"><span class="text-sm font-semibold uppercase tracking-widest" style="color: var(--mut);">Meta:</span><span class="font-mono font-bold px-2 py-0.5 rounded" style="background: var(--ok-bg); color: var(--ok);">&lt; 100 mg/dL</span></div></div><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right hidden md:block w-5 h-5 shrink-0" aria-hidden="true" style="color: var(--faint);"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg><div class="flex items-center gap-4 md:w-64 shrink-0"><div class="relative flex-1 h-10 flex items-center px-3 rounded-md border" style="background: var(--ph); border-color: var(--bd);"><span class="text-sm italic" style="color: var(--mut);">Sin datos</span></div><div class="w-[14px] h-[14px] rounded-full shrink-0 shadow-sm transition-colors duration-500" style="background: var(--ph);"></div></div></div><div class="mt-4 pt-4 border-t text-sm leading-relaxed" style="border-color: var(--bd); color: var(--mut);">El LDL menor a 100 mg/dL es la meta para diabéticos sin enfermedad cardiovascular. Si tiene enfermedad cardiovascular, la meta es menor a 70 mg/dL. La mayoría de diabéticos requiere estatinas.</div></div><div class="rounded-xl p-5 sm:p-6 shadow-sm hover:border-primary/20 transition-colors" style="background: var(--card); border: 1.5px solid; border-width: var(--card-bd); border-style: var(--card-bd); border-color: var(--card-bd);"><div class="flex flex-col md:flex-row md:items-center gap-6"><div class="flex-1"><div class="flex items-center gap-3 mb-1 flex-wrap"><h4 class="font-display font-semibold text-lg" style="color: var(--text);">Colesterol HDL</h4><span class="text-xs px-2 py-0.5 rounded font-medium" style="background: var(--ph); color: var(--mut);">Rango deseable</span></div><div class="flex items-center gap-2 mt-2"><span class="text-sm font-semibold uppercase tracking-widest" style="color: var(--mut);">Meta:</span><span class="font-mono font-bold px-2 py-0.5 rounded" style="background: var(--ok-bg); color: var(--ok);">&gt; 40 mg/dL (hombres) / &gt; 50 mg/dL (mujeres)</span></div></div><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right hidden md:block w-5 h-5 shrink-0" aria-hidden="true" style="color: var(--faint);"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg><div class="flex items-center gap-4 md:w-64 shrink-0"><div class="relative flex-1 h-10 flex items-center px-3 rounded-md border" style="background: var(--ph); border-color: var(--bd);"><span class="text-sm italic" style="color: var(--mut);">Sin datos</span></div><div class="w-[14px] h-[14px] rounded-full shrink-0 shadow-sm transition-colors duration-500" style="background: var(--ph);"></div></div></div><div class="mt-4 pt-4 border-t text-sm leading-relaxed" style="border-color: var(--bd); color: var(--mut);">El colesterol HDL es el 'colesterol bueno'. Valores bajos se asocian a mayor riesgo cardiovascular.</div></div><div class="rounded-xl p-5 sm:p-6 shadow-sm hover:border-primary/20 transition-colors" style="background: var(--card); border: 1.5px solid; border-width: var(--card-bd); border-style: var(--card-bd); border-color: var(--card-bd);"><div class="flex flex-col md:flex-row md:items-center gap-6"><div class="flex-1"><div class="flex items-center gap-3 mb-1 flex-wrap"><h4 class="font-display font-semibold text-lg" style="color: var(--text);">Colesterol total</h4><span class="text-xs px-2 py-0.5 rounded font-medium" style="background: var(--ph); color: var(--mut);">Rango deseable</span></div><div class="flex items-center gap-2 mt-2"><span class="text-sm font-semibold uppercase tracking-widest" style="color: var(--mut);">Meta:</span><span class="font-mono font-bold px-2 py-0.5 rounded" style="background: var(--ok-bg); color: var(--ok);">&lt; 200 mg/dL</span></div></div><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right hidden md:block w-5 h-5 shrink-0" aria-hidden="true" style="color: var(--faint);"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg><div class="flex items-center gap-4 md:w-64 shrink-0"><div class="relative flex-1 h-10 flex items-center px-3 rounded-md border" style="background: var(--ph); border-color: var(--bd);"><span class="text-sm italic" style="color: var(--mut);">Sin datos</span></div><div class="w-[14px] h-[14px] rounded-full shrink-0 shadow-sm transition-colors duration-500" style="background: var(--ph);"></div></div></div><div class="mt-4 pt-4 border-t text-sm leading-relaxed" style="border-color: var(--bd); color: var(--mut);">Suma de LDL, HDL y otros componentes. Por debajo de 200 mg/dL se considera deseable.</div></div><div class="rounded-xl p-5 sm:p-6 shadow-sm hover:border-primary/20 transition-colors" style="background: var(--card); border: 1.5px solid; border-width: var(--card-bd); border-style: var(--card-bd); border-color: var(--card-bd);"><div class="flex flex-col md:flex-row md:items-center gap-6"><div class="flex-1"><div class="flex items-center gap-3 mb-1 flex-wrap"><h4 class="font-display font-semibold text-lg" style="color: var(--text);">Triglicéridos</h4><span class="text-xs px-2 py-0.5 rounded font-medium" style="background: var(--ph); color: var(--mut);">Rango deseable</span></div><div class="flex items-center gap-2 mt-2"><span class="text-sm font-semibold uppercase tracking-widest" style="color: var(--mut);">Meta:</span><span class="font-mono font-bold px-2 py-0.5 rounded" style="background: var(--ok-bg); color: var(--ok);">&lt; 150 mg/dL</span></div></div><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right hidden md:block w-5 h-5 shrink-0" aria-hidden="true" style="color: var(--faint);"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg><div class="flex items-center gap-4 md:w-64 shrink-0"><div class="relative flex-1 h-10 flex items-center px-3 rounded-md border" style="background: var(--ph); border-color: var(--bd);"><span class="text-sm italic" style="color: var(--mut);">Sin datos</span></div><div class="w-[14px] h-[14px] rounded-full shrink-0 shadow-sm transition-colors duration-500" style="background: var(--ph);"></div></div></div><div class="mt-4 pt-4 border-t text-sm leading-relaxed" style="border-color: var(--bd); color: var(--mut);">Los triglicéridos elevados se asocian a riesgo cardiovascular y pancreatitis. Muy altos (≥ 500 mg/dL) requieren atención urgente.</div></div><div class="rounded-xl p-5 sm:p-6 shadow-sm hover:border-primary/20 transition-colors" style="background: var(--card); border: 1.5px solid; border-width: var(--card-bd); border-style: var(--card-bd); border-color: var(--card-bd);"><div class="flex flex-col md:flex-row md:items-center gap-6"><div class="flex-1"><div class="flex items-center gap-3 mb-1 flex-wrap"><h4 class="font-display font-semibold text-lg" style="color: var(--text);">Creatinina sérica</h4><span class="text-xs px-2 py-0.5 rounded font-medium" style="background: var(--ph); color: var(--mut);">Rango de referencia</span></div><div class="flex items-center gap-2 mt-2"><span class="text-sm font-semibold uppercase tracking-widest" style="color: var(--mut);">Meta:</span><span class="font-mono font-bold px-2 py-0.5 rounded" style="background: var(--ok-bg); color: var(--ok);">0.7–1.3 mg/dL (hombres) / 0.5–1.2 mg/dL (mujeres)</span></div></div><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right hidden md:block w-5 h-5 shrink-0" aria-hidden="true" style="color: var(--faint);"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg><div class="flex items-center gap-4 md:w-64 shrink-0"><div class="relative flex-1 h-10 flex items-center px-3 rounded-md border" style="background: var(--ph); border-color: var(--bd);"><span class="text-sm italic" style="color: var(--mut);">Sin datos</span></div><div class="w-[14px] h-[14px] rounded-full shrink-0 shadow-sm transition-colors duration-500" style="background: var(--ph);"></div></div></div><div class="mt-4 pt-4 border-t text-sm leading-relaxed" style="border-color: var(--bd); color: var(--mut);">Marcador de función renal. Valores elevados sugieren deterioro del riñón.</div></div><div class="rounded-xl p-5 sm:p-6 shadow-sm hover:border-primary/20 transition-colors" style="background: var(--card); border: 1.5px solid; border-width: var(--card-bd); border-style: var(--card-bd); border-color: var(--card-bd);"><div class="flex flex-col md:flex-row md:items-center gap-6"><div class="flex-1"><div class="flex items-center gap-3 mb-1 flex-wrap"><h4 class="font-display font-semibold text-lg" style="color: var(--text);">Tasa de filtración glomerular estimada (eGFR)</h4><span class="text-xs px-2 py-0.5 rounded font-medium" style="background: var(--ph); color: var(--mut);">Función renal</span></div><div class="flex items-center gap-2 mt-2"><span class="text-sm font-semibold uppercase tracking-widest" style="color: var(--mut);">Meta:</span><span class="font-mono font-bold px-2 py-0.5 rounded" style="background: var(--ok-bg); color: var(--ok);">≥ 60 ml/min/1.73m²</span></div></div><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right hidden md:block w-5 h-5 shrink-0" aria-hidden="true" style="color: var(--faint);"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg><div class="flex items-center gap-4 md:w-64 shrink-0"><div class="relative flex-1 h-10 flex items-center px-3 rounded-md border" style="background: var(--ph); border-color: var(--bd);"><span class="text-sm italic" style="color: var(--mut);">Disponible al evaluar</span></div><div class="w-[14px] h-[14px] rounded-full shrink-0 shadow-sm transition-colors duration-500" style="background: var(--ph);"></div></div></div><div class="mt-4 pt-4 border-t text-sm leading-relaxed" style="border-color: var(--bd); color: var(--mut);">Estima la capacidad del riñón para filtrar sangre. Por debajo de 60 indica función renal reducida; por debajo de 30 requiere atención especializada.</div></div><div class="rounded-xl p-5 sm:p-6 shadow-sm hover:border-primary/20 transition-colors" style="background: var(--card); border: 1.5px solid; border-width: var(--card-bd); border-style: var(--card-bd); border-color: var(--card-bd);"><div class="flex flex-col md:flex-row md:items-center gap-6"><div class="flex-1"><div class="flex items-center gap-3 mb-1 flex-wrap"><h4 class="font-display font-semibold text-lg" style="color: var(--text);">Nitrógeno ureico en sangre (BUN)</h4><span class="text-xs px-2 py-0.5 rounded font-medium" style="background: var(--ph); color: var(--mut);">Rango de referencia</span></div><div class="flex items-center gap-2 mt-2"><span class="text-sm font-semibold uppercase tracking-widest" style="color: var(--mut);">Meta:</span><span class="font-mono font-bold px-2 py-0.5 rounded" style="background: var(--ok-bg); color: var(--ok);">7–21 mg/dL</span></div></div><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right hidden md:block w-5 h-5 shrink-0" aria-hidden="true" style="color: var(--faint);"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg><div class="flex items-center gap-4 md:w-64 shrink-0"><div class="relative flex-1 h-10 flex items-center px-3 rounded-md border" style="background: var(--ph); border-color: var(--bd);"><span class="text-sm italic" style="color: var(--mut);">Sin datos</span></div><div class="w-[14px] h-[14px] rounded-full shrink-0 shadow-sm transition-colors duration-500" style="background: var(--ph);"></div></div></div><div class="mt-4 pt-4 border-t text-sm leading-relaxed" style="border-color: var(--bd); color: var(--mut);">Marcador de función renal y metabolismo proteico. Valores fuera de rango pueden indicar problemas renales o de hidratación.</div></div><div class="rounded-xl p-5 sm:p-6 shadow-sm hover:border-primary/20 transition-colors" style="background: var(--card); border: 1.5px solid; border-width: var(--card-bd); border-style: var(--card-bd); border-color: var(--card-bd);"><div class="flex flex-col md:flex-row md:items-center gap-6"><div class="flex-1"><div class="flex items-center gap-3 mb-1 flex-wrap"><h4 class="font-display font-semibold text-lg" style="color: var(--text);">Perímetro de cintura</h4><span class="text-xs px-2 py-0.5 rounded font-medium" style="background: var(--ph); color: var(--mut);">Riesgo cardiometabólico</span></div><div class="flex items-center gap-2 mt-2"><span class="text-sm font-semibold uppercase tracking-widest" style="color: var(--mut);">Meta:</span><span class="font-mono font-bold px-2 py-0.5 rounded" style="background: var(--ok-bg); color: var(--ok);">&lt; 94 cm (hombres) / &lt; 80 cm (mujeres)</span></div></div><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right hidden md:block w-5 h-5 shrink-0" aria-hidden="true" style="color: var(--faint);"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg><div class="flex items-center gap-4 md:w-64 shrink-0"><div class="relative flex-1 h-10 flex items-center px-3 rounded-md border" style="background: var(--ph); border-color: var(--bd);"><span class="text-sm italic" style="color: var(--mut);">Sin datos</span></div><div class="w-[14px] h-[14px] rounded-full shrink-0 shadow-sm transition-colors duration-500" style="background: var(--ph);"></div></div></div><div class="mt-4 pt-4 border-t text-sm leading-relaxed" style="border-color: var(--bd); color: var(--mut);">El perímetro de cintura elevado se asocia a mayor riesgo de diabetes y enfermedad cardiovascular.</div></div></div><div class="mt-10 flex justify-center"><button type="button" tabindex="0" data-slot="button" class="group/button inline-flex shrink-0 items-center justify-center rounded-lg border border-transparent bg-clip-padding font-medium whitespace-nowrap transition-all outline-none select-none focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/50 active:not-aria-[haspopup]:translate-y-px disabled:pointer-events-none disabled:opacity-50 aria-invalid:border-destructive aria-invalid:ring-3 aria-invalid:ring-destructive/20 dark:aria-invalid:border-destructive/50 dark:aria-invalid:ring-destructive/40 [&amp;_svg]:pointer-events-none [&amp;_svg]:shrink-0 [&amp;_svg:not([class*='size-'])]:size-4 bg-primary text-primary-foreground [a]:hover:bg-primary/80 gap-1.5 has-data-[icon=inline-end]:pr-2 has-data-[icon=inline-start]:pl-2 w-full sm:w-auto h-14 px-10 text-lg shadow-md">Evaluar mis metas</button></div><div class="mt-12 pt-6 border-t text-center text-sm" style="border-color: var(--bd); color: var(--mut);"><p>Valores de referencia basados en los estándares de atención médica de la ADA (Standards of Care 2026).</p></div></div>"`;

exports[`MetasScreen — DOM snapshots > paciente normal, sin evaluar 1`] = `"<div class="max-w-4xl mx-auto pb-12 animate-in fade-in duration-500"><p class="text-lg mb-8" style="color: var(--mut);">Tus últimos resultados disponibles han sido cargados automáticamente. Los parámetros sin datos no cuentan con registros recientes.</p><div class="space-y-4"><div class="rounded-xl p-5 sm:p-6 shadow-sm hover:border-primary/20 transition-colors" style="background: var(--card); border: 1.5px solid; border-width: var(--card-bd); border-style: var(--card-bd); border-color: var(--card-bd);"><div class="flex flex-col md:flex-row md:items-center gap-6"><div class="flex-1"><div class="flex items-center gap-3 mb-1 flex-wrap"><h4 class="font-display font-semibold text-lg" style="color: var(--text);">HbA1c</h4><span class="text-xs px-2 py-0.5 rounded font-medium" style="background: var(--ph); color: var(--mut);">ADA 2026 — diabetes</span></div><div class="flex items-center gap-2 mt-2"><span class="text-sm font-semibold uppercase tracking-widest" style="color: var(--mut);">Meta:</span><span class="font-mono font-bold px-2 py-0.5 rounded" style="background: var(--ok-bg); color: var(--ok);">&lt; 7.0%</span></div></div><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right hidden md:block w-5 h-5 shrink-0" aria-hidden="true" style="color: var(--faint);"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg><div class="flex items-center gap-4 md:w-64 shrink-0"><div class="relative flex-1 h-10 flex items-center px-3 rounded-md border" style="background: var(--ph); border-color: var(--bd);"><span class="text-sm italic" style="color: var(--mut);">Sin datos</span></div><div class="w-[14px] h-[14px] rounded-full shrink-0 shadow-sm transition-colors duration-500" style="background: var(--ph);"></div></div></div><div class="mt-4 pt-4 border-t text-sm leading-relaxed" style="border-color: var(--bd); color: var(--mut);">El principal indicador de control en diabetes. Una HbA1c menor a 7% se asocia con menor riesgo de complicaciones. La meta puede individualizarse según edad y condiciones.</div></div><div class="rounded-xl p-5 sm:p-6 shadow-sm hover:border-primary/20 transition-colors" style="background: var(--card); border: 1.5px solid; border-width: var(--card-bd); border-style: var(--card-bd); border-color: var(--card-bd);"><div class="flex flex-col md:flex-row md:items-center gap-6"><div class="flex-1"><div class="flex items-center gap-3 mb-1 flex-wrap"><h4 class="font-display font-semibold text-lg" style="color: var(--text);">Glucosa en ayuno</h4><span class="text-xs px-2 py-0.5 rounded font-medium" style="background: var(--ph); color: var(--mut);">ADA 2026 — preprandial</span></div><div class="flex items-center gap-2 mt-2"><span class="text-sm font-semibold uppercase tracking-widest" style="color: var(--mut);">Meta:</span><span class="font-mono font-bold px-2 py-0.5 rounded" style="background: var(--ok-bg); color: var(--ok);">80–130 mg/dL</span></div></div><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right hidden md:block w-5 h-5 shrink-0" aria-hidden="true" style="color: var(--faint);"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg><div class="flex items-center gap-4 md:w-64 shrink-0"><div class="relative flex-1 h-10 flex items-center px-3 rounded-md border" style="background: var(--ph); border-color: var(--bd);"><span class="text-sm italic" style="color: var(--mut);">Sin datos</span></div><div class="w-[14px] h-[14px] rounded-full shrink-0 shadow-sm transition-colors duration-500" style="background: var(--ph);"></div></div></div><div class="mt-4 pt-4 border-t text-sm leading-relaxed" style="border-color: var(--bd); color: var(--mut);">La glucosa en ayuno ideal para diabéticos es entre 80 y 130 mg/dL. Por encima de 130 sugiere ajuste de tratamiento.</div></div><div class="rounded-xl p-5 sm:p-6 shadow-sm hover:border-primary/20 transition-colors" style="background: var(--card); border: 1.5px solid; border-width: var(--card-bd); border-style: var(--card-bd); border-color: var(--card-bd);"><div class="flex flex-col md:flex-row md:items-center gap-6"><div class="flex-1"><div class="flex items-center gap-3 mb-1 flex-wrap"><h4 class="font-display font-semibold text-lg" style="color: var(--text);">Glucosa postprandial (1 h)</h4><span class="text-xs px-2 py-0.5 rounded font-medium" style="background: var(--ph); color: var(--mut);">ADA 2026 — postprandial</span></div><div class="flex items-center gap-2 mt-2"><span class="text-sm font-semibold uppercase tracking-widest" style="color: var(--mut);">Meta:</span><span class="font-mono font-bold px-2 py-0.5 rounded" style="background: var(--ok-bg); color: var(--ok);">&lt; 180 mg/dL</span></div></div><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right hidden md:block w-5 h-5 shrink-0" aria-hidden="true" style="color: var(--faint);"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg><div class="flex items-center gap-4 md:w-64 shrink-0"><div class="relative flex-1 h-10 flex items-center px-3 rounded-md border" style="background: var(--ph); border-color: var(--bd);"><span class="text-sm italic" style="color: var(--mut);">Disponible al evaluar</span></div><div class="w-[14px] h-[14px] rounded-full shrink-0 shadow-sm transition-colors duration-500" style="background: var(--ph);"></div></div></div><div class="mt-4 pt-4 border-t text-sm leading-relaxed" style="border-color: var(--bd); color: var(--mut);">Medición de glucosa una hora después de comer. Meta en diabéticos: menor a 180 mg/dL.</div></div><div class="rounded-xl p-5 sm:p-6 shadow-sm hover:border-primary/20 transition-colors" style="background: var(--card); border: 1.5px solid; border-width: var(--card-bd); border-style: var(--card-bd); border-color: var(--card-bd);"><div class="flex flex-col md:flex-row md:items-center gap-6"><div class="flex-1"><div class="flex items-center gap-3 mb-1 flex-wrap"><h4 class="font-display font-semibold text-lg" style="color: var(--text);">Glucosa postprandial (2 h)</h4><span class="text-xs px-2 py-0.5 rounded font-medium" style="background: var(--ph); color: var(--mut);">ADA 2026 — postprandial</span></div><div class="flex items-center gap-2 mt-2"><span class="text-sm font-semibold uppercase tracking-widest" style="color: var(--mut);">Meta:</span><span class="font-mono font-bold px-2 py-0.5 rounded" style="background: var(--ok-bg); color: var(--ok);">&lt; 180 mg/dL</span></div></div><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right hidden md:block w-5 h-5 shrink-0" aria-hidden="true" style="color: var(--faint);"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg><div class="flex items-center gap-4 md:w-64 shrink-0"><div class="relative flex-1 h-10 flex items-center px-3 rounded-md border" style="background: var(--ph); border-color: var(--bd);"><span class="text-sm italic" style="color: var(--mut);">Disponible al evaluar</span></div><div class="w-[14px] h-[14px] rounded-full shrink-0 shadow-sm transition-colors duration-500" style="background: var(--ph);"></div></div></div><div class="mt-4 pt-4 border-t text-sm leading-relaxed" style="border-color: var(--bd); color: var(--mut);">Medición de glucosa dos horas después de comer. Meta en diabéticos: menor a 180 mg/dL.</div></div><div class="rounded-xl p-5 sm:p-6 shadow-sm hover:border-primary/20 transition-colors" style="background: var(--card); border: 1.5px solid; border-width: var(--card-bd); border-style: var(--card-bd); border-color: var(--card-bd);"><div class="flex flex-col md:flex-row md:items-center gap-6"><div class="flex-1"><div class="flex items-center gap-3 mb-1 flex-wrap"><h4 class="font-display font-semibold text-lg" style="color: var(--text);">Presión arterial sistólica</h4><span class="text-xs px-2 py-0.5 rounded font-medium" style="background: var(--ph); color: var(--mut);">ADA 2026 — diabetes</span></div><div class="flex items-center gap-2 mt-2"><span class="text-sm font-semibold uppercase tracking-widest" style="color: var(--mut);">Meta:</span><span class="font-mono font-bold px-2 py-0.5 rounded" style="background: var(--ok-bg); color: var(--ok);">&lt; 130 mmHg</span></div></div><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right hidden md:block w-5 h-5 shrink-0" aria-hidden="true" style="color: var(--faint);"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg><div class="flex items-center gap-4 md:w-64 shrink-0"><div class="relative flex-1 h-10 flex items-center px-3 rounded-md border" style="background: var(--ph); border-color: var(--bd);"><span class="text-sm italic" style="color: var(--mut);">Sin datos</span></div><div class="w-[14px] h-[14px] rounded-full shrink-0 shadow-sm transition-colors duration-500" style="background: var(--ph);"></div></div></div><div class="mt-4 pt-4 border-t text-sm leading-relaxed" style="border-color: var(--bd); color: var(--mut);">En personas con diabetes, mantener la presión sistólica menor a 130 mmHg reduce el riesgo de infarto, accidente vascular y nefropatía.</div></div><div class="rounded-xl p-5 sm:p-6 shadow-sm hover:border-primary/20 transition-colors" style="background: var(--card); border: 1.5px solid; border-width: var(--card-bd); border-style: var(--card-bd); border-color: var(--card-bd);"><div class="flex flex-col md:flex-row md:items-center gap-6"><div class="flex-1"><div class="flex items-center gap-3 mb-1 flex-wrap"><h4 class="font-display font-semibold text-lg" style="color: var(--text);">Presión arterial diastólica</h4><span class="text-xs px-2 py-0.5 rounded font-medium" style="background: var(--ph); color: var(--mut);">ADA 2026 — diabetes</span></div><div class="flex items-center gap-2 mt-2"><span class="text-sm font-semibold uppercase tracking-widest" style="color: var(--mut);">Meta:</span><span class="font-mono font-bold px-2 py-0.5 rounded" style="background: var(--ok-bg); color: var(--ok);">&lt; 80 mmHg</span></div></div><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right hidden md:block w-5 h-5 shrink-0" aria-hidden="true" style="color: var(--faint);"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg><div class="flex items-center gap-4 md:w-64 shrink-0"><div class="relative flex-1 h-10 flex items-center px-3 rounded-md border" style="background: var(--ph); border-color: var(--bd);"><span class="text-sm italic" style="color: var(--mut);">Sin datos</span></div><div class="w-[14px] h-[14px] rounded-full shrink-0 shadow-sm transition-colors duration-500" style="background: var(--ph);"></div></div></div><div class="mt-4 pt-4 border-t text-sm leading-relaxed" style="border-color: var(--bd); color: var(--mut);">En personas con diabetes, mantener la presión diastólica menor a 80 mmHg reduce el riesgo cardiovascular y renal.</div></div><div class="rounded-xl p-5 sm:p-6 shadow-sm hover:border-primary/20 transition-colors" style="background: var(--card); border: 1.5px solid; border-width: var(--card-bd); border-style: var(--card-bd); border-color: var(--card-bd);"><div class="flex flex-col md:flex-row md:items-center gap-6"><div class="flex-1"><div class="flex items-center gap-3 mb-1 flex-wrap"><h4 class="font-display font-semibold text-lg" style="color: var(--text);">Frecuencia cardíaca</h4><span class="text-xs px-2 py-0.5 rounded font-medium" style="background: var(--ph); color: var(--mut);">Rango normal</span></div><div class="flex items-center gap-2 mt-2"><span class="text-sm font-semibold uppercase tracking-widest" style="color: var(--mut);">Meta:</span><span class="font-mono font-bold px-2 py-0.5 rounded" style="background: var(--ok-bg); color: var(--ok);">60–100 lat/min</span></div></div><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right hidden md:block w-5 h-5 shrink-0" aria-hidden="true" style="color: var(--faint);"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg><div class="flex items-center gap-4 md:w-64 shrink-0"><div class="relative flex-1 h-10 flex items-center px-3 rounded-md border" style="background: var(--ph); border-color: var(--bd);"><span class="text-sm italic" style="color: var(--mut);">Sin datos</span></div><div class="w-[14px] h-[14px] rounded-full shrink-0 shadow-sm transition-colors duration-500" style="background: var(--ph);"></div></div></div><div class="mt-4 pt-4 border-t text-sm leading-relaxed" style="border-color: var(--bd); color: var(--mut);">Frecuencia cardíaca en reposo. Valores fuera de 60–100 lat/min requieren evaluación clínica.</div></div><div class="rounded-xl p-5 sm:p-6 shadow-sm hover:border-primary/20 transition-colors" style="background: var(--card); border: 1.5px solid; border-width: var(--card-bd); border-style: var(--card-bd); border-color: var(--card-bd);"><div class="flex flex-col md:flex-row md:items-center gap-6"><div class="flex-1"><div class="flex items-center gap-3 mb-1 flex-wrap"><h4 class="font-display font-semibold text-lg" style="color: var(--text);">Índice de Masa Corporal (IMC)</h4><span class="text-xs px-2 py-0.5 rounded font-medium" style="background: var(--ph); color: var(--mut);">Rango saludable</span></div><div class="flex items-center gap-2 mt-2"><span class="text-sm font-semibold uppercase tracking-widest" style="color: var(--mut);">Meta:</span><span class="font-mono font-bold px-2 py-0.5 rounded" style="background: var(--ok-bg); color: var(--ok);">18.5–24.9</span></div></div><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right hidden md:block w-5 h-5 shrink-0" aria-hidden="true" style="color: var(--faint);"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg><div class="flex items-center gap-4 md:w-64 shrink-0"><div class="relative flex-1 h-10 flex items-center px-3 rounded-md border" style="background: var(--ph); border-color: var(--bd);"><span class="text-sm italic" style="color: var(--mut);">Sin datos</span></div><div class="w-[14px] h-[14px] rounded-full shrink-0 shadow-sm transition-colors duration-500" style="background: var(--ph);"></div></div></div><div class="mt-4 pt-4 border-t text-sm leading-relaxed" style="border-color: var(--bd); color: var(--mut);">El IMC se calcula con peso y estatura. Un peso saludable mejora el control glucémico y reduce la dosis de medicamentos necesaria.</div></div><div class="rounded-xl p-5 sm:p-6 shadow-sm hover:border-primary/20 transition-colors" style="background: var(--card); border: 1.5px solid; border-width: var(--card-bd); border-style: var(--card-bd); border-color: var(--card-bd);"><div class="flex flex-col md:flex-row md:items-center gap-6"><div class="flex-1"><div class="flex items-center gap-3 mb-1 flex-wrap"><h4 class="font-display font-semibold text-lg" style="color: var(--text);">Colesterol LDL</h4><span class="text-xs px-2 py-0.5 rounded font-medium" style="background: var(--ph); color: var(--mut);">ADA 2026 — diabetes</span></div><div class="flex items-center gap-2 mt-2"><span class="text-sm font-semibold uppercase tracking-widest" style="color: var(--mut);">Meta:</span><span class="font-mono font-bold px-2 py-0.5 rounded" style="background: var(--ok-bg); color: var(--ok);">&lt; 100 mg/dL</span></div></div><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right hidden md:block w-5 h-5 shrink-0" aria-hidden="true" style="color: var(--faint);"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg><div class="flex items-center gap-4 md:w-64 shrink-0"><div class="relative flex-1 h-10 flex items-center px-3 rounded-md border" style="background: var(--ph); border-color: var(--bd);"><span class="text-sm italic" style="color: var(--mut);">Sin datos</span></div><div class="w-[14px] h-[14px] rounded-full shrink-0 shadow-sm transition-colors duration-500" style="background: var(--ph);"></div></div></div><div class="mt-4 pt-4 border-t text-sm leading-relaxed" style="border-color: var(--bd); color: var(--mut);">El LDL menor a 100 mg/dL es la meta para diabéticos sin enfermedad cardiovascular. Si tiene enfermedad cardiovascular, la meta es menor a 70 mg/dL. La mayoría de diabéticos requiere estatinas.</div></div><div class="rounded-xl p-5 sm:p-6 shadow-sm hover:border-primary/20 transition-colors" style="background: var(--card); border: 1.5px solid; border-width: var(--card-bd); border-style: var(--card-bd); border-color: var(--card-bd);"><div class="flex flex-col md:flex-row md:items-center gap-6"><div class="flex-1"><div class="flex items-center gap-3 mb-1 flex-wrap"><h4 class="font-display font-semibold text-lg" style="color: var(--text);">Colesterol HDL</h4><span class="text-xs px-2 py-0.5 rounded font-medium" style="background: var(--ph); color: var(--mut);">Rango deseable</span></div><div class="flex items-center gap-2 mt-2"><span class="text-sm font-semibold uppercase tracking-widest" style="color: var(--mut);">Meta:</span><span class="font-mono font-bold px-2 py-0.5 rounded" style="background: var(--ok-bg); color: var(--ok);">&gt; 40 mg/dL (hombres) / &gt; 50 mg/dL (mujeres)</span></div></div><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right hidden md:block w-5 h-5 shrink-0" aria-hidden="true" style="color: var(--faint);"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg><div class="flex items-center gap-4 md:w-64 shrink-0"><div class="relative flex-1 h-10 flex items-center px-3 rounded-md border" style="background: var(--ph); border-color: var(--bd);"><span class="text-sm italic" style="color: var(--mut);">Sin datos</span></div><div class="w-[14px] h-[14px] rounded-full shrink-0 shadow-sm transition-colors duration-500" style="background: var(--ph);"></div></div></div><div class="mt-4 pt-4 border-t text-sm leading-relaxed" style="border-color: var(--bd); color: var(--mut);">El colesterol HDL es el 'colesterol bueno'. Valores bajos se asocian a mayor riesgo cardiovascular.</div></div><div class="rounded-xl p-5 sm:p-6 shadow-sm hover:border-primary/20 transition-colors" style="background: var(--card); border: 1.5px solid; border-width: var(--card-bd); border-style: var(--card-bd); border-color: var(--card-bd);"><div class="flex flex-col md:flex-row md:items-center gap-6"><div class="flex-1"><div class="flex items-center gap-3 mb-1 flex-wrap"><h4 class="font-display font-semibold text-lg" style="color: var(--text);">Colesterol total</h4><span class="text-xs px-2 py-0.5 rounded font-medium" style="background: var(--ph); color: var(--mut);">Rango deseable</span></div><div class="flex items-center gap-2 mt-2"><span class="text-sm font-semibold uppercase tracking-widest" style="color: var(--mut);">Meta:</span><span class="font-mono font-bold px-2 py-0.5 rounded" style="background: var(--ok-bg); color: var(--ok);">&lt; 200 mg/dL</span></div></div><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right hidden md:block w-5 h-5 shrink-0" aria-hidden="true" style="color: var(--faint);"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg><div class="flex items-center gap-4 md:w-64 shrink-0"><div class="relative flex-1 h-10 flex items-center px-3 rounded-md border" style="background: var(--ph); border-color: var(--bd);"><span class="text-sm italic" style="color: var(--mut);">Sin datos</span></div><div class="w-[14px] h-[14px] rounded-full shrink-0 shadow-sm transition-colors duration-500" style="background: var(--ph);"></div></div></div><div class="mt-4 pt-4 border-t text-sm leading-relaxed" style="border-color: var(--bd); color: var(--mut);">Suma de LDL, HDL y otros componentes. Por debajo de 200 mg/dL se considera deseable.</div></div><div class="rounded-xl p-5 sm:p-6 shadow-sm hover:border-primary/20 transition-colors" style="background: var(--card); border: 1.5px solid; border-width: var(--card-bd); border-style: var(--card-bd); border-color: var(--card-bd);"><div class="flex flex-col md:flex-row md:items-center gap-6"><div class="flex-1"><div class="flex items-center gap-3 mb-1 flex-wrap"><h4 class="font-display font-semibold text-lg" style="color: var(--text);">Triglicéridos</h4><span class="text-xs px-2 py-0.5 rounded font-medium" style="background: var(--ph); color: var(--mut);">Rango deseable</span></div><div class="flex items-center gap-2 mt-2"><span class="text-sm font-semibold uppercase tracking-widest" style="color: var(--mut);">Meta:</span><span class="font-mono font-bold px-2 py-0.5 rounded" style="background: var(--ok-bg); color: var(--ok);">&lt; 150 mg/dL</span></div></div><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right hidden md:block w-5 h-5 shrink-0" aria-hidden="true" style="color: var(--faint);"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg><div class="flex items-center gap-4 md:w-64 shrink-0"><div class="relative flex-1 h-10 flex items-center px-3 rounded-md border" style="background: var(--ph); border-color: var(--bd);"><span class="text-sm italic" style="color: var(--mut);">Sin datos</span></div><div class="w-[14px] h-[14px] rounded-full shrink-0 shadow-sm transition-colors duration-500" style="background: var(--ph);"></div></div></div><div class="mt-4 pt-4 border-t text-sm leading-relaxed" style="border-color: var(--bd); color: var(--mut);">Los triglicéridos elevados se asocian a riesgo cardiovascular y pancreatitis. Muy altos (≥ 500 mg/dL) requieren atención urgente.</div></div><div class="rounded-xl p-5 sm:p-6 shadow-sm hover:border-primary/20 transition-colors" style="background: var(--card); border: 1.5px solid; border-width: var(--card-bd); border-style: var(--card-bd); border-color: var(--card-bd);"><div class="flex flex-col md:flex-row md:items-center gap-6"><div class="flex-1"><div class="flex items-center gap-3 mb-1 flex-wrap"><h4 class="font-display font-semibold text-lg" style="color: var(--text);">Creatinina sérica</h4><span class="text-xs px-2 py-0.5 rounded font-medium" style="background: var(--ph); color: var(--mut);">Rango de referencia</span></div><div class="flex items-center gap-2 mt-2"><span class="text-sm font-semibold uppercase tracking-widest" style="color: var(--mut);">Meta:</span><span class="font-mono font-bold px-2 py-0.5 rounded" style="background: var(--ok-bg); color: var(--ok);">0.7–1.3 mg/dL (hombres) / 0.5–1.2 mg/dL (mujeres)</span></div></div><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right hidden md:block w-5 h-5 shrink-0" aria-hidden="true" style="color: var(--faint);"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg><div class="flex items-center gap-4 md:w-64 shrink-0"><div class="relative flex-1 h-10 flex items-center px-3 rounded-md border" style="background: var(--ph); border-color: var(--bd);"><span class="text-sm italic" style="color: var(--mut);">Sin datos</span></div><div class="w-[14px] h-[14px] rounded-full shrink-0 shadow-sm transition-colors duration-500" style="background: var(--ph);"></div></div></div><div class="mt-4 pt-4 border-t text-sm leading-relaxed" style="border-color: var(--bd); color: var(--mut);">Marcador de función renal. Valores elevados sugieren deterioro del riñón.</div></div><div class="rounded-xl p-5 sm:p-6 shadow-sm hover:border-primary/20 transition-colors" style="background: var(--card); border: 1.5px solid; border-width: var(--card-bd); border-style: var(--card-bd); border-color: var(--card-bd);"><div class="flex flex-col md:flex-row md:items-center gap-6"><div class="flex-1"><div class="flex items-center gap-3 mb-1 flex-wrap"><h4 class="font-display font-semibold text-lg" style="color: var(--text);">Tasa de filtración glomerular estimada (eGFR)</h4><span class="text-xs px-2 py-0.5 rounded font-medium" style="background: var(--ph); color: var(--mut);">Función renal</span></div><div class="flex items-center gap-2 mt-2"><span class="text-sm font-semibold uppercase tracking-widest" style="color: var(--mut);">Meta:</span><span class="font-mono font-bold px-2 py-0.5 rounded" style="background: var(--ok-bg); color: var(--ok);">≥ 60 ml/min/1.73m²</span></div></div><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right hidden md:block w-5 h-5 shrink-0" aria-hidden="true" style="color: var(--faint);"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg><div class="flex items-center gap-4 md:w-64 shrink-0"><div class="relative flex-1 h-10 flex items-center px-3 rounded-md border" style="background: var(--ph); border-color: var(--bd);"><span class="text-sm italic" style="color: var(--mut);">Disponible al evaluar</span></div><div class="w-[14px] h-[14px] rounded-full shrink-0 shadow-sm transition-colors duration-500" style="background: var(--ph);"></div></div></div><div class="mt-4 pt-4 border-t text-sm leading-relaxed" style="border-color: var(--bd); color: var(--mut);">Estima la capacidad del riñón para filtrar sangre. Por debajo de 60 indica función renal reducida; por debajo de 30 requiere atención especializada.</div></div><div class="rounded-xl p-5 sm:p-6 shadow-sm hover:border-primary/20 transition-colors" style="background: var(--card); border: 1.5px solid; border-width: var(--card-bd); border-style: var(--card-bd); border-color: var(--card-bd);"><div class="flex flex-col md:flex-row md:items-center gap-6"><div class="flex-1"><div class="flex items-center gap-3 mb-1 flex-wrap"><h4 class="font-display font-semibold text-lg" style="color: var(--text);">Nitrógeno ureico en sangre (BUN)</h4><span class="text-xs px-2 py-0.5 rounded font-medium" style="background: var(--ph); color: var(--mut);">Rango de referencia</span></div><div class="flex items-center gap-2 mt-2"><span class="text-sm font-semibold uppercase tracking-widest" style="color: var(--mut);">Meta:</span><span class="font-mono font-bold px-2 py-0.5 rounded" style="background: var(--ok-bg); color: var(--ok);">7–21 mg/dL</span></div></div><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right hidden md:block w-5 h-5 shrink-0" aria-hidden="true" style="color: var(--faint);"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg><div class="flex items-center gap-4 md:w-64 shrink-0"><div class="relative flex-1 h-10 flex items-center px-3 rounded-md border" style="background: var(--ph); border-color: var(--bd);"><span class="text-sm italic" style="color: var(--mut);">Sin datos</span></div><div class="w-[14px] h-[14px] rounded-full shrink-0 shadow-sm transition-colors duration-500" style="background: var(--ph);"></div></div></div><div class="mt-4 pt-4 border-t text-sm leading-relaxed" style="border-color: var(--bd); color: var(--mut);">Marcador de función renal y metabolismo proteico. Valores fuera de rango pueden indicar problemas renales o de hidratación.</div></div><div class="rounded-xl p-5 sm:p-6 shadow-sm hover:border-primary/20 transition-colors" style="background: var(--card); border: 1.5px solid; border-width: var(--card-bd); border-style: var(--card-bd); border-color: var(--card-bd);"><div class="flex flex-col md:flex-row md:items-center gap-6"><div class="flex-1"><div class="flex items-center gap-3 mb-1 flex-wrap"><h4 class="font-display font-semibold text-lg" style="color: var(--text);">Perímetro de cintura</h4><span class="text-xs px-2 py-0.5 rounded font-medium" style="background: var(--ph); color: var(--mut);">Riesgo cardiometabólico</span></div><div class="flex items-center gap-2 mt-2"><span class="text-sm font-semibold uppercase tracking-widest" style="color: var(--mut);">Meta:</span><span class="font-mono font-bold px-2 py-0.5 rounded" style="background: var(--ok-bg); color: var(--ok);">&lt; 94 cm (hombres) / &lt; 80 cm (mujeres)</span></div></div><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right hidden md:block w-5 h-5 shrink-0" aria-hidden="true" style="color: var(--faint);"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg><div class="flex items-center gap-4 md:w-64 shrink-0"><div class="relative flex-1 h-10 flex items-center px-3 rounded-md border" style="background: var(--ph); border-color: var(--bd);"><span class="text-sm italic" style="color: var(--mut);">Sin datos</span></div><div class="w-[14px] h-[14px] rounded-full shrink-0 shadow-sm transition-colors duration-500" style="background: var(--ph);"></div></div></div><div class="mt-4 pt-4 border-t text-sm leading-relaxed" style="border-color: var(--bd); color: var(--mut);">El perímetro de cintura elevado se asocia a mayor riesgo de diabetes y enfermedad cardiovascular.</div></div></div><div class="mt-10 flex justify-center"><button type="button" tabindex="0" data-slot="button" class="group/button inline-flex shrink-0 items-center justify-center rounded-lg border border-transparent bg-clip-padding font-medium whitespace-nowrap transition-all outline-none select-none focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/50 active:not-aria-[haspopup]:translate-y-px disabled:pointer-events-none disabled:opacity-50 aria-invalid:border-destructive aria-invalid:ring-3 aria-invalid:ring-destructive/20 dark:aria-invalid:border-destructive/50 dark:aria-invalid:ring-destructive/40 [&amp;_svg]:pointer-events-none [&amp;_svg]:shrink-0 [&amp;_svg:not([class*='size-'])]:size-4 bg-primary text-primary-foreground [a]:hover:bg-primary/80 gap-1.5 has-data-[icon=inline-end]:pr-2 has-data-[icon=inline-start]:pl-2 w-full sm:w-auto h-14 px-10 text-lg shadow-md">Evaluar mis metas</button></div><div class="mt-12 pt-6 border-t text-center text-sm" style="border-color: var(--bd); color: var(--mut);"><p>Valores de referencia basados en los estándares de atención médica de la ADA (Standards of Care 2026).</p></div></div>"`;

exports[`MetasScreen — DOM snapshots > post-evaluación con card, resumen y CkdStageExplainer 1`] = `"<div class="max-w-4xl mx-auto pb-12 animate-in fade-in duration-500"><p class="text-lg mb-8" style="color: var(--mut);">Tus últimos resultados disponibles han sido cargados automáticamente. Los parámetros sin datos no cuentan con registros recientes.</p><div class="space-y-4"><div class="rounded-xl p-5 sm:p-6 shadow-sm hover:border-primary/20 transition-colors" style="background: var(--card); border: 1.5px solid; border-width: var(--card-bd); border-style: var(--card-bd); border-color: var(--card-bd);"><div class="flex flex-col md:flex-row md:items-center gap-6"><div class="flex-1"><div class="flex items-center gap-3 mb-1 flex-wrap"><h4 class="font-display font-semibold text-lg" style="color: var(--text);">HbA1c</h4><span class="text-xs px-2 py-0.5 rounded font-medium" style="background: var(--ph); color: var(--mut);">ADA 2026 — diabetes</span></div><div class="flex items-center gap-2 mt-2"><span class="text-sm font-semibold uppercase tracking-widest" style="color: var(--mut);">Meta:</span><span class="font-mono font-bold px-2 py-0.5 rounded" style="background: var(--ok-bg); color: var(--ok);">&lt; 7.0%</span></div></div><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right hidden md:block w-5 h-5 shrink-0" aria-hidden="true" style="color: var(--faint);"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg><div class="flex items-center gap-4 md:w-64 shrink-0"><div class="relative flex-1 h-10 flex items-center px-3 rounded-md border" style="background: var(--ph); border-color: var(--bd);"><span class="text-lg font-medium" style="color: var(--text);">6.4</span><span class="absolute right-3 top-1/2 -translate-y-1/2 text-sm font-medium pointer-events-none" style="color: var(--mut);">%</span></div><div class="w-[14px] h-[14px] rounded-full shrink-0 shadow-sm transition-colors duration-500" style="background: var(--ok);"></div></div></div><div class="mt-4 pt-4 border-t text-sm leading-relaxed" style="border-color: var(--bd); color: var(--mut);">El principal indicador de control en diabetes. Una HbA1c menor a 7% se asocia con menor riesgo de complicaciones. La meta puede individualizarse según edad y condiciones.</div></div><div class="rounded-xl p-5 sm:p-6 shadow-sm hover:border-primary/20 transition-colors" style="background: var(--card); border: 1.5px solid; border-width: var(--card-bd); border-style: var(--card-bd); border-color: var(--card-bd);"><div class="flex flex-col md:flex-row md:items-center gap-6"><div class="flex-1"><div class="flex items-center gap-3 mb-1 flex-wrap"><h4 class="font-display font-semibold text-lg" style="color: var(--text);">Glucosa en ayuno</h4><span class="text-xs px-2 py-0.5 rounded font-medium" style="background: var(--ph); color: var(--mut);">ADA 2026 — preprandial</span></div><div class="flex items-center gap-2 mt-2"><span class="text-sm font-semibold uppercase tracking-widest" style="color: var(--mut);">Meta:</span><span class="font-mono font-bold px-2 py-0.5 rounded" style="background: var(--ok-bg); color: var(--ok);">80–130 mg/dL</span></div></div><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right hidden md:block w-5 h-5 shrink-0" aria-hidden="true" style="color: var(--faint);"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg><div class="flex items-center gap-4 md:w-64 shrink-0"><div class="relative flex-1 h-10 flex items-center px-3 rounded-md border" style="background: var(--ph); border-color: var(--bd);"><span class="text-sm italic" style="color: var(--mut);">Sin datos</span></div><div class="w-[14px] h-[14px] rounded-full shrink-0 shadow-sm transition-colors duration-500" style="background: var(--ph);"></div></div></div><div class="mt-4 pt-4 border-t text-sm leading-relaxed" style="border-color: var(--bd); color: var(--mut);">La glucosa en ayuno ideal para diabéticos es entre 80 y 130 mg/dL. Por encima de 130 sugiere ajuste de tratamiento.</div></div><div class="rounded-xl p-5 sm:p-6 shadow-sm hover:border-primary/20 transition-colors" style="background: var(--card); border: 1.5px solid; border-width: var(--card-bd); border-style: var(--card-bd); border-color: var(--card-bd);"><div class="flex flex-col md:flex-row md:items-center gap-6"><div class="flex-1"><div class="flex items-center gap-3 mb-1 flex-wrap"><h4 class="font-display font-semibold text-lg" style="color: var(--text);">Glucosa postprandial (1 h)</h4><span class="text-xs px-2 py-0.5 rounded font-medium" style="background: var(--ph); color: var(--mut);">ADA 2026 — postprandial</span></div><div class="flex items-center gap-2 mt-2"><span class="text-sm font-semibold uppercase tracking-widest" style="color: var(--mut);">Meta:</span><span class="font-mono font-bold px-2 py-0.5 rounded" style="background: var(--ok-bg); color: var(--ok);">&lt; 180 mg/dL</span></div></div><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right hidden md:block w-5 h-5 shrink-0" aria-hidden="true" style="color: var(--faint);"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg><div class="flex items-center gap-4 md:w-64 shrink-0"><div class="relative flex-1 h-10 flex items-center px-3 rounded-md border" style="background: var(--ph); border-color: var(--bd);"><span class="text-sm italic" style="color: var(--mut);">Sin datos</span></div><div class="w-[14px] h-[14px] rounded-full shrink-0 shadow-sm transition-colors duration-500" style="background: var(--ph);"></div></div></div><div class="mt-4 pt-4 border-t text-sm leading-relaxed" style="border-color: var(--bd); color: var(--mut);">Medición de glucosa una hora después de comer. Meta en diabéticos: menor a 180 mg/dL.</div></div><div class="rounded-xl p-5 sm:p-6 shadow-sm hover:border-primary/20 transition-colors" style="background: var(--card); border: 1.5px solid; border-width: var(--card-bd); border-style: var(--card-bd); border-color: var(--card-bd);"><div class="flex flex-col md:flex-row md:items-center gap-6"><div class="flex-1"><div class="flex items-center gap-3 mb-1 flex-wrap"><h4 class="font-display font-semibold text-lg" style="color: var(--text);">Glucosa postprandial (2 h)</h4><span class="text-xs px-2 py-0.5 rounded font-medium" style="background: var(--ph); color: var(--mut);">ADA 2026 — postprandial</span></div><div class="flex items-center gap-2 mt-2"><span class="text-sm font-semibold uppercase tracking-widest" style="color: var(--mut);">Meta:</span><span class="font-mono font-bold px-2 py-0.5 rounded" style="background: var(--ok-bg); color: var(--ok);">&lt; 180 mg/dL</span></div></div><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right hidden md:block w-5 h-5 shrink-0" aria-hidden="true" style="color: var(--faint);"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg><div class="flex items-center gap-4 md:w-64 shrink-0"><div class="relative flex-1 h-10 flex items-center px-3 rounded-md border" style="background: var(--ph); border-color: var(--bd);"><span class="text-sm italic" style="color: var(--mut);">Sin datos</span></div><div class="w-[14px] h-[14px] rounded-full shrink-0 shadow-sm transition-colors duration-500" style="background: var(--ph);"></div></div></div><div class="mt-4 pt-4 border-t text-sm leading-relaxed" style="border-color: var(--bd); color: var(--mut);">Medición de glucosa dos horas después de comer. Meta en diabéticos: menor a 180 mg/dL.</div></div><div class="rounded-xl p-5 sm:p-6 shadow-sm hover:border-primary/20 transition-colors" style="background: var(--card); border: 1.5px solid; border-width: var(--card-bd); border-style: var(--card-bd); border-color: var(--card-bd);"><div class="flex flex-col md:flex-row md:items-center gap-6"><div class="flex-1"><div class="flex items-center gap-3 mb-1 flex-wrap"><h4 class="font-display font-semibold text-lg" style="color: var(--text);">Presión arterial sistólica</h4><span class="text-xs px-2 py-0.5 rounded font-medium" style="background: var(--ph); color: var(--mut);">ADA 2026 — diabetes</span></div><div class="flex items-center gap-2 mt-2"><span class="text-sm font-semibold uppercase tracking-widest" style="color: var(--mut);">Meta:</span><span class="font-mono font-bold px-2 py-0.5 rounded" style="background: var(--ok-bg); color: var(--ok);">&lt; 130 mmHg</span></div></div><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right hidden md:block w-5 h-5 shrink-0" aria-hidden="true" style="color: var(--faint);"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg><div class="flex items-center gap-4 md:w-64 shrink-0"><div class="relative flex-1 h-10 flex items-center px-3 rounded-md border" style="background: var(--ph); border-color: var(--bd);"><span class="text-sm italic" style="color: var(--mut);">Sin datos</span></div><div class="w-[14px] h-[14px] rounded-full shrink-0 shadow-sm transition-colors duration-500" style="background: var(--ph);"></div></div></div><div class="mt-4 pt-4 border-t text-sm leading-relaxed" style="border-color: var(--bd); color: var(--mut);">En personas con diabetes, mantener la presión sistólica menor a 130 mmHg reduce el riesgo de infarto, accidente vascular y nefropatía.</div></div><div class="rounded-xl p-5 sm:p-6 shadow-sm hover:border-primary/20 transition-colors" style="background: var(--card); border: 1.5px solid; border-width: var(--card-bd); border-style: var(--card-bd); border-color: var(--card-bd);"><div class="flex flex-col md:flex-row md:items-center gap-6"><div class="flex-1"><div class="flex items-center gap-3 mb-1 flex-wrap"><h4 class="font-display font-semibold text-lg" style="color: var(--text);">Presión arterial diastólica</h4><span class="text-xs px-2 py-0.5 rounded font-medium" style="background: var(--ph); color: var(--mut);">ADA 2026 — diabetes</span></div><div class="flex items-center gap-2 mt-2"><span class="text-sm font-semibold uppercase tracking-widest" style="color: var(--mut);">Meta:</span><span class="font-mono font-bold px-2 py-0.5 rounded" style="background: var(--ok-bg); color: var(--ok);">&lt; 80 mmHg</span></div></div><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right hidden md:block w-5 h-5 shrink-0" aria-hidden="true" style="color: var(--faint);"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg><div class="flex items-center gap-4 md:w-64 shrink-0"><div class="relative flex-1 h-10 flex items-center px-3 rounded-md border" style="background: var(--ph); border-color: var(--bd);"><span class="text-sm italic" style="color: var(--mut);">Sin datos</span></div><div class="w-[14px] h-[14px] rounded-full shrink-0 shadow-sm transition-colors duration-500" style="background: var(--ph);"></div></div></div><div class="mt-4 pt-4 border-t text-sm leading-relaxed" style="border-color: var(--bd); color: var(--mut);">En personas con diabetes, mantener la presión diastólica menor a 80 mmHg reduce el riesgo cardiovascular y renal.</div></div><div class="rounded-xl p-5 sm:p-6 shadow-sm hover:border-primary/20 transition-colors" style="background: var(--card); border: 1.5px solid; border-width: var(--card-bd); border-style: var(--card-bd); border-color: var(--card-bd);"><div class="flex flex-col md:flex-row md:items-center gap-6"><div class="flex-1"><div class="flex items-center gap-3 mb-1 flex-wrap"><h4 class="font-display font-semibold text-lg" style="color: var(--text);">Frecuencia cardíaca</h4><span class="text-xs px-2 py-0.5 rounded font-medium" style="background: var(--ph); color: var(--mut);">Rango normal</span></div><div class="flex items-center gap-2 mt-2"><span class="text-sm font-semibold uppercase tracking-widest" style="color: var(--mut);">Meta:</span><span class="font-mono font-bold px-2 py-0.5 rounded" style="background: var(--ok-bg); color: var(--ok);">60–100 lat/min</span></div></div><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right hidden md:block w-5 h-5 shrink-0" aria-hidden="true" style="color: var(--faint);"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg><div class="flex items-center gap-4 md:w-64 shrink-0"><div class="relative flex-1 h-10 flex items-center px-3 rounded-md border" style="background: var(--ph); border-color: var(--bd);"><span class="text-sm italic" style="color: var(--mut);">Sin datos</span></div><div class="w-[14px] h-[14px] rounded-full shrink-0 shadow-sm transition-colors duration-500" style="background: var(--ph);"></div></div></div><div class="mt-4 pt-4 border-t text-sm leading-relaxed" style="border-color: var(--bd); color: var(--mut);">Frecuencia cardíaca en reposo. Valores fuera de 60–100 lat/min requieren evaluación clínica.</div></div><div class="rounded-xl p-5 sm:p-6 shadow-sm hover:border-primary/20 transition-colors" style="background: var(--card); border: 1.5px solid; border-width: var(--card-bd); border-style: var(--card-bd); border-color: var(--card-bd);"><div class="flex flex-col md:flex-row md:items-center gap-6"><div class="flex-1"><div class="flex items-center gap-3 mb-1 flex-wrap"><h4 class="font-display font-semibold text-lg" style="color: var(--text);">Índice de Masa Corporal (IMC)</h4><span class="text-xs px-2 py-0.5 rounded font-medium" style="background: var(--ph); color: var(--mut);">Rango saludable</span></div><div class="flex items-center gap-2 mt-2"><span class="text-sm font-semibold uppercase tracking-widest" style="color: var(--mut);">Meta:</span><span class="font-mono font-bold px-2 py-0.5 rounded" style="background: var(--ok-bg); color: var(--ok);">18.5–24.9</span></div></div><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right hidden md:block w-5 h-5 shrink-0" aria-hidden="true" style="color: var(--faint);"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg><div class="flex items-center gap-4 md:w-64 shrink-0"><div class="relative flex-1 h-10 flex items-center px-3 rounded-md border" style="background: var(--ph); border-color: var(--bd);"><span class="text-sm italic" style="color: var(--mut);">Sin datos</span></div><div class="w-[14px] h-[14px] rounded-full shrink-0 shadow-sm transition-colors duration-500" style="background: var(--ph);"></div></div></div><div class="mt-4 pt-4 border-t text-sm leading-relaxed" style="border-color: var(--bd); color: var(--mut);">El IMC se calcula con peso y estatura. Un peso saludable mejora el control glucémico y reduce la dosis de medicamentos necesaria.</div></div><div class="rounded-xl p-5 sm:p-6 shadow-sm hover:border-primary/20 transition-colors" style="background: var(--card); border: 1.5px solid; border-width: var(--card-bd); border-style: var(--card-bd); border-color: var(--card-bd);"><div class="flex flex-col md:flex-row md:items-center gap-6"><div class="flex-1"><div class="flex items-center gap-3 mb-1 flex-wrap"><h4 class="font-display font-semibold text-lg" style="color: var(--text);">Colesterol LDL</h4><span class="text-xs px-2 py-0.5 rounded font-medium" style="background: var(--ph); color: var(--mut);">ADA 2026 — diabetes</span></div><div class="flex items-center gap-2 mt-2"><span class="text-sm font-semibold uppercase tracking-widest" style="color: var(--mut);">Meta:</span><span class="font-mono font-bold px-2 py-0.5 rounded" style="background: var(--ok-bg); color: var(--ok);">&lt; 100 mg/dL</span></div></div><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right hidden md:block w-5 h-5 shrink-0" aria-hidden="true" style="color: var(--faint);"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg><div class="flex items-center gap-4 md:w-64 shrink-0"><div class="relative flex-1 h-10 flex items-center px-3 rounded-md border" style="background: var(--ph); border-color: var(--bd);"><span class="text-sm italic" style="color: var(--mut);">Sin datos</span></div><div class="w-[14px] h-[14px] rounded-full shrink-0 shadow-sm transition-colors duration-500" style="background: var(--ph);"></div></div></div><div class="mt-4 pt-4 border-t text-sm leading-relaxed" style="border-color: var(--bd); color: var(--mut);">El LDL menor a 100 mg/dL es la meta para diabéticos sin enfermedad cardiovascular. Si tiene enfermedad cardiovascular, la meta es menor a 70 mg/dL. La mayoría de diabéticos requiere estatinas.</div></div><div class="rounded-xl p-5 sm:p-6 shadow-sm hover:border-primary/20 transition-colors" style="background: var(--card); border: 1.5px solid; border-width: var(--card-bd); border-style: var(--card-bd); border-color: var(--card-bd);"><div class="flex flex-col md:flex-row md:items-center gap-6"><div class="flex-1"><div class="flex items-center gap-3 mb-1 flex-wrap"><h4 class="font-display font-semibold text-lg" style="color: var(--text);">Colesterol HDL</h4><span class="text-xs px-2 py-0.5 rounded font-medium" style="background: var(--ph); color: var(--mut);">Rango deseable</span></div><div class="flex items-center gap-2 mt-2"><span class="text-sm font-semibold uppercase tracking-widest" style="color: var(--mut);">Meta:</span><span class="font-mono font-bold px-2 py-0.5 rounded" style="background: var(--ok-bg); color: var(--ok);">&gt; 40 mg/dL (hombres) / &gt; 50 mg/dL (mujeres)</span></div></div><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right hidden md:block w-5 h-5 shrink-0" aria-hidden="true" style="color: var(--faint);"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg><div class="flex items-center gap-4 md:w-64 shrink-0"><div class="relative flex-1 h-10 flex items-center px-3 rounded-md border" style="background: var(--ph); border-color: var(--bd);"><span class="text-sm italic" style="color: var(--mut);">Sin datos</span></div><div class="w-[14px] h-[14px] rounded-full shrink-0 shadow-sm transition-colors duration-500" style="background: var(--ph);"></div></div></div><div class="mt-4 pt-4 border-t text-sm leading-relaxed" style="border-color: var(--bd); color: var(--mut);">El colesterol HDL es el 'colesterol bueno'. Valores bajos se asocian a mayor riesgo cardiovascular.</div></div><div class="rounded-xl p-5 sm:p-6 shadow-sm hover:border-primary/20 transition-colors" style="background: var(--card); border: 1.5px solid; border-width: var(--card-bd); border-style: var(--card-bd); border-color: var(--card-bd);"><div class="flex flex-col md:flex-row md:items-center gap-6"><div class="flex-1"><div class="flex items-center gap-3 mb-1 flex-wrap"><h4 class="font-display font-semibold text-lg" style="color: var(--text);">Colesterol total</h4><span class="text-xs px-2 py-0.5 rounded font-medium" style="background: var(--ph); color: var(--mut);">Rango deseable</span></div><div class="flex items-center gap-2 mt-2"><span class="text-sm font-semibold uppercase tracking-widest" style="color: var(--mut);">Meta:</span><span class="font-mono font-bold px-2 py-0.5 rounded" style="background: var(--ok-bg); color: var(--ok);">&lt; 200 mg/dL</span></div></div><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right hidden md:block w-5 h-5 shrink-0" aria-hidden="true" style="color: var(--faint);"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg><div class="flex items-center gap-4 md:w-64 shrink-0"><div class="relative flex-1 h-10 flex items-center px-3 rounded-md border" style="background: var(--ph); border-color: var(--bd);"><span class="text-sm italic" style="color: var(--mut);">Sin datos</span></div><div class="w-[14px] h-[14px] rounded-full shrink-0 shadow-sm transition-colors duration-500" style="background: var(--ph);"></div></div></div><div class="mt-4 pt-4 border-t text-sm leading-relaxed" style="border-color: var(--bd); color: var(--mut);">Suma de LDL, HDL y otros componentes. Por debajo de 200 mg/dL se considera deseable.</div></div><div class="rounded-xl p-5 sm:p-6 shadow-sm hover:border-primary/20 transition-colors" style="background: var(--card); border: 1.5px solid; border-width: var(--card-bd); border-style: var(--card-bd); border-color: var(--card-bd);"><div class="flex flex-col md:flex-row md:items-center gap-6"><div class="flex-1"><div class="flex items-center gap-3 mb-1 flex-wrap"><h4 class="font-display font-semibold text-lg" style="color: var(--text);">Triglicéridos</h4><span class="text-xs px-2 py-0.5 rounded font-medium" style="background: var(--ph); color: var(--mut);">Rango deseable</span></div><div class="flex items-center gap-2 mt-2"><span class="text-sm font-semibold uppercase tracking-widest" style="color: var(--mut);">Meta:</span><span class="font-mono font-bold px-2 py-0.5 rounded" style="background: var(--ok-bg); color: var(--ok);">&lt; 150 mg/dL</span></div></div><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right hidden md:block w-5 h-5 shrink-0" aria-hidden="true" style="color: var(--faint);"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg><div class="flex items-center gap-4 md:w-64 shrink-0"><div class="relative flex-1 h-10 flex items-center px-3 rounded-md border" style="background: var(--ph); border-color: var(--bd);"><span class="text-sm italic" style="color: var(--mut);">Sin datos</span></div><div class="w-[14px] h-[14px] rounded-full shrink-0 shadow-sm transition-colors duration-500" style="background: var(--ph);"></div></div></div><div class="mt-4 pt-4 border-t text-sm leading-relaxed" style="border-color: var(--bd); color: var(--mut);">Los triglicéridos elevados se asocian a riesgo cardiovascular y pancreatitis. Muy altos (≥ 500 mg/dL) requieren atención urgente.</div></div><div class="rounded-xl p-5 sm:p-6 shadow-sm hover:border-primary/20 transition-colors" style="background: var(--card); border: 1.5px solid; border-width: var(--card-bd); border-style: var(--card-bd); border-color: var(--card-bd);"><div class="flex flex-col md:flex-row md:items-center gap-6"><div class="flex-1"><div class="flex items-center gap-3 mb-1 flex-wrap"><h4 class="font-display font-semibold text-lg" style="color: var(--text);">Creatinina sérica</h4><span class="text-xs px-2 py-0.5 rounded font-medium" style="background: var(--ph); color: var(--mut);">Rango de referencia</span></div><div class="flex items-center gap-2 mt-2"><span class="text-sm font-semibold uppercase tracking-widest" style="color: var(--mut);">Meta:</span><span class="font-mono font-bold px-2 py-0.5 rounded" style="background: var(--ok-bg); color: var(--ok);">0.7–1.3 mg/dL (hombres) / 0.5–1.2 mg/dL (mujeres)</span></div></div><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right hidden md:block w-5 h-5 shrink-0" aria-hidden="true" style="color: var(--faint);"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg><div class="flex items-center gap-4 md:w-64 shrink-0"><div class="relative flex-1 h-10 flex items-center px-3 rounded-md border" style="background: var(--ph); border-color: var(--bd);"><span class="text-sm italic" style="color: var(--mut);">Sin datos</span></div><div class="w-[14px] h-[14px] rounded-full shrink-0 shadow-sm transition-colors duration-500" style="background: var(--ph);"></div></div></div><div class="mt-4 pt-4 border-t text-sm leading-relaxed" style="border-color: var(--bd); color: var(--mut);">Marcador de función renal. Valores elevados sugieren deterioro del riñón.</div></div><div class="rounded-xl p-5 sm:p-6 shadow-sm hover:border-primary/20 transition-colors" style="background: var(--card); border: 1.5px solid; border-width: var(--card-bd); border-style: var(--card-bd); border-color: var(--card-bd);"><div class="flex flex-col md:flex-row md:items-center gap-6"><div class="flex-1"><div class="flex items-center gap-3 mb-1 flex-wrap"><h4 class="font-display font-semibold text-lg" style="color: var(--text);">Tasa de filtración glomerular estimada (eGFR)</h4><span class="text-xs px-2 py-0.5 rounded font-medium" style="background: var(--ph); color: var(--mut);">Función renal</span></div><div class="flex items-center gap-2 mt-2"><span class="text-sm font-semibold uppercase tracking-widest" style="color: var(--mut);">Meta:</span><span class="font-mono font-bold px-2 py-0.5 rounded" style="background: var(--ok-bg); color: var(--ok);">≥ 60 ml/min/1.73m²</span></div></div><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right hidden md:block w-5 h-5 shrink-0" aria-hidden="true" style="color: var(--faint);"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg><div class="flex items-center gap-4 md:w-64 shrink-0"><div class="relative flex-1 h-10 flex items-center px-3 rounded-md border" style="background: var(--ph); border-color: var(--bd);"><span class="text-lg font-medium" style="color: var(--text);">72</span><span class="absolute right-3 top-1/2 -translate-y-1/2 text-sm font-medium pointer-events-none" style="color: var(--mut);">ml/min/1.73m²</span></div><div class="w-[14px] h-[14px] rounded-full shrink-0 shadow-sm transition-colors duration-500" style="background: var(--ok);"></div></div></div><div class="mt-4 pt-4 border-t text-sm leading-relaxed" style="border-color: var(--bd); color: var(--mut);">Estima la capacidad del riñón para filtrar sangre. Por debajo de 60 indica función renal reducida; por debajo de 30 requiere atención especializada.</div></div><div class="rounded-xl p-5 sm:p-6 shadow-sm hover:border-primary/20 transition-colors" style="background: var(--card); border: 1.5px solid; border-width: var(--card-bd); border-style: var(--card-bd); border-color: var(--card-bd);"><div class="flex flex-col md:flex-row md:items-center gap-6"><div class="flex-1"><div class="flex items-center gap-3 mb-1 flex-wrap"><h4 class="font-display font-semibold text-lg" style="color: var(--text);">Nitrógeno ureico en sangre (BUN)</h4><span class="text-xs px-2 py-0.5 rounded font-medium" style="background: var(--ph); color: var(--mut);">Rango de referencia</span></div><div class="flex items-center gap-2 mt-2"><span class="text-sm font-semibold uppercase tracking-widest" style="color: var(--mut);">Meta:</span><span class="font-mono font-bold px-2 py-0.5 rounded" style="background: var(--ok-bg); color: var(--ok);">7–21 mg/dL</span></div></div><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right hidden md:block w-5 h-5 shrink-0" aria-hidden="true" style="color: var(--faint);"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg><div class="flex items-center gap-4 md:w-64 shrink-0"><div class="relative flex-1 h-10 flex items-center px-3 rounded-md border" style="background: var(--ph); border-color: var(--bd);"><span class="text-sm italic" style="color: var(--mut);">Sin datos</span></div><div class="w-[14px] h-[14px] rounded-full shrink-0 shadow-sm transition-colors duration-500" style="background: var(--ph);"></div></div></div><div class="mt-4 pt-4 border-t text-sm leading-relaxed" style="border-color: var(--bd); color: var(--mut);">Marcador de función renal y metabolismo proteico. Valores fuera de rango pueden indicar problemas renales o de hidratación.</div></div><div class="rounded-xl p-5 sm:p-6 shadow-sm hover:border-primary/20 transition-colors" style="background: var(--card); border: 1.5px solid; border-width: var(--card-bd); border-style: var(--card-bd); border-color: var(--card-bd);"><div class="flex flex-col md:flex-row md:items-center gap-6"><div class="flex-1"><div class="flex items-center gap-3 mb-1 flex-wrap"><h4 class="font-display font-semibold text-lg" style="color: var(--text);">Perímetro de cintura</h4><span class="text-xs px-2 py-0.5 rounded font-medium" style="background: var(--ph); color: var(--mut);">Riesgo cardiometabólico</span></div><div class="flex items-center gap-2 mt-2"><span class="text-sm font-semibold uppercase tracking-widest" style="color: var(--mut);">Meta:</span><span class="font-mono font-bold px-2 py-0.5 rounded" style="background: var(--ok-bg); color: var(--ok);">&lt; 94 cm (hombres) / &lt; 80 cm (mujeres)</span></div></div><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right hidden md:block w-5 h-5 shrink-0" aria-hidden="true" style="color: var(--faint);"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg><div class="flex items-center gap-4 md:w-64 shrink-0"><div class="relative flex-1 h-10 flex items-center px-3 rounded-md border" style="background: var(--ph); border-color: var(--bd);"><span class="text-sm italic" style="color: var(--mut);">Sin datos</span></div><div class="w-[14px] h-[14px] rounded-full shrink-0 shadow-sm transition-colors duration-500" style="background: var(--ph);"></div></div></div><div class="mt-4 pt-4 border-t text-sm leading-relaxed" style="border-color: var(--bd); color: var(--mut);">El perímetro de cintura elevado se asocia a mayor riesgo de diabetes y enfermedad cardiovascular.</div></div></div><div class="mt-10 flex justify-center"><button type="button" tabindex="0" data-slot="button" class="group/button inline-flex shrink-0 items-center justify-center rounded-lg border border-transparent bg-clip-padding font-medium whitespace-nowrap transition-all outline-none select-none focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/50 active:not-aria-[haspopup]:translate-y-px disabled:pointer-events-none disabled:opacity-50 aria-invalid:border-destructive aria-invalid:ring-3 aria-invalid:ring-destructive/20 dark:aria-invalid:border-destructive/50 dark:aria-invalid:ring-destructive/40 [&amp;_svg]:pointer-events-none [&amp;_svg]:shrink-0 [&amp;_svg:not([class*='size-'])]:size-4 bg-primary text-primary-foreground [a]:hover:bg-primary/80 gap-1.5 has-data-[icon=inline-end]:pr-2 has-data-[icon=inline-start]:pl-2 w-full sm:w-auto h-14 px-10 text-lg shadow-md">Evaluar mis metas</button></div><div id="resumen-metas" class="animate-in slide-in-from-bottom-8 duration-700 mt-12 space-y-8"><div class="bg-card border rounded-xl p-6 sm:p-10 shadow-md" style="border-color: var(--bd);"><h3 class="text-xl font-display font-semibold mb-6" style="color: var(--text);">Tu Estado Actual</h3><div class="grid grid-cols-2 md:grid-cols-3 gap-4"><div class="p-4 rounded-lg border-2 flex flex-col justify-center items-center text-center" style="background: var(--ok-bg); border-color: var(--ok); color: var(--ok);"><span class="text-2xl font-bold font-mono" style="color: var(--text);">6.4</span><span class="text-sm font-medium mt-1" style="color: var(--mut);">HbA1c</span></div><div class="p-4 rounded-lg border-2 flex flex-col justify-center items-center text-center" style="background: var(--ph); border-color: var(--bd); color: var(--soft);"><span class="text-2xl font-bold font-mono" style="color: var(--text);">—</span><span class="text-sm font-medium mt-1" style="color: var(--mut);">Glucosa en ayuno</span></div><div class="p-4 rounded-lg border-2 flex flex-col justify-center items-center text-center" style="background: var(--ph); border-color: var(--bd); color: var(--soft);"><span class="text-2xl font-bold font-mono" style="color: var(--text);">—</span><span class="text-sm font-medium mt-1" style="color: var(--mut);">Glucosa postprandial (1 h)</span></div><div class="p-4 rounded-lg border-2 flex flex-col justify-center items-center text-center" style="background: var(--ph); border-color: var(--bd); color: var(--soft);"><span class="text-2xl font-bold font-mono" style="color: var(--text);">—</span><span class="text-sm font-medium mt-1" style="color: var(--mut);">Glucosa postprandial (2 h)</span></div><div class="p-4 rounded-lg border-2 flex flex-col justify-center items-center text-center" style="background: var(--ph); border-color: var(--bd); color: var(--soft);"><span class="text-2xl font-bold font-mono" style="color: var(--text);">—</span><span class="text-sm font-medium mt-1" style="color: var(--mut);">Presión arterial sistólica</span></div><div class="p-4 rounded-lg border-2 flex flex-col justify-center items-center text-center" style="background: var(--ph); border-color: var(--bd); color: var(--soft);"><span class="text-2xl font-bold font-mono" style="color: var(--text);">—</span><span class="text-sm font-medium mt-1" style="color: var(--mut);">Presión arterial diastólica</span></div><div class="p-4 rounded-lg border-2 flex flex-col justify-center items-center text-center" style="background: var(--ph); border-color: var(--bd); color: var(--soft);"><span class="text-2xl font-bold font-mono" style="color: var(--text);">—</span><span class="text-sm font-medium mt-1" style="color: var(--mut);">Frecuencia cardíaca</span></div><div class="p-4 rounded-lg border-2 flex flex-col justify-center items-center text-center" style="background: var(--ph); border-color: var(--bd); color: var(--soft);"><span class="text-2xl font-bold font-mono" style="color: var(--text);">—</span><span class="text-sm font-medium mt-1" style="color: var(--mut);">Índice de Masa Corporal (IMC)</span></div><div class="p-4 rounded-lg border-2 flex flex-col justify-center items-center text-center" style="background: var(--ph); border-color: var(--bd); color: var(--soft);"><span class="text-2xl font-bold font-mono" style="color: var(--text);">—</span><span class="text-sm font-medium mt-1" style="color: var(--mut);">Colesterol LDL</span></div><div class="p-4 rounded-lg border-2 flex flex-col justify-center items-center text-center" style="background: var(--ph); border-color: var(--bd); color: var(--soft);"><span class="text-2xl font-bold font-mono" style="color: var(--text);">—</span><span class="text-sm font-medium mt-1" style="color: var(--mut);">Colesterol HDL</span></div><div class="p-4 rounded-lg border-2 flex flex-col justify-center items-center text-center" style="background: var(--ph); border-color: var(--bd); color: var(--soft);"><span class="text-2xl font-bold font-mono" style="color: var(--text);">—</span><span class="text-sm font-medium mt-1" style="color: var(--mut);">Colesterol total</span></div><div class="p-4 rounded-lg border-2 flex flex-col justify-center items-center text-center" style="background: var(--ph); border-color: var(--bd); color: var(--soft);"><span class="text-2xl font-bold font-mono" style="color: var(--text);">—</span><span class="text-sm font-medium mt-1" style="color: var(--mut);">Triglicéridos</span></div><div class="p-4 rounded-lg border-2 flex flex-col justify-center items-center text-center" style="background: var(--ph); border-color: var(--bd); color: var(--soft);"><span class="text-2xl font-bold font-mono" style="color: var(--text);">—</span><span class="text-sm font-medium mt-1" style="color: var(--mut);">Creatinina sérica</span></div><div class="p-4 rounded-lg border-2 flex flex-col justify-center items-center text-center" style="background: var(--ok-bg); border-color: var(--ok); color: var(--ok);"><span class="text-2xl font-bold font-mono" style="color: var(--text);">72</span><span class="text-sm font-medium mt-1" style="color: var(--mut);">Tasa de filtración glomerular estimada (eGFR)</span></div><div class="p-4 rounded-lg border-2 flex flex-col justify-center items-center text-center" style="background: var(--ph); border-color: var(--bd); color: var(--soft);"><span class="text-2xl font-bold font-mono" style="color: var(--text);">—</span><span class="text-sm font-medium mt-1" style="color: var(--mut);">Nitrógeno ureico en sangre (BUN)</span></div><div class="p-4 rounded-lg border-2 flex flex-col justify-center items-center text-center" style="background: var(--ph); border-color: var(--bd); color: var(--soft);"><span class="text-2xl font-bold font-mono" style="color: var(--text);">—</span><span class="text-sm font-medium mt-1" style="color: var(--mut);">Perímetro de cintura</span></div></div><div class="mt-10 space-y-4"><div class="flex items-start gap-3 p-3 rounded-lg" style="background: var(--ok-bg);"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check w-5 h-5 shrink-0 mt-0.5" aria-hidden="true" style="color: var(--ok);"><circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"></path></svg><p style="color: var(--text);"><strong class="font-bold">2 parámetro(s) en meta</strong> — Excelente trabajo, continúe así.</p></div><div class="flex items-start gap-3 p-3 rounded-lg" style="background: var(--ph);"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-minus w-5 h-5 shrink-0 mt-0.5" aria-hidden="true" style="color: var(--mut);"><circle cx="12" cy="12" r="10"></circle><path d="M8 12h8"></path></svg><p style="color: var(--text);"><strong class="font-bold">14 dato(s) sin ingresar</strong> — Solicite estos estudios en su próxima consulta.</p></div></div></div></div><div class="mt-8 space-y-6"><div data-slot="card" class="rounded-2xl border" style="background: var(--card); border-color: var(--card-bd); color: var(--text); font-family: Sora, sans-serif; padding: 20px;"><div data-slot="card-header" class="mb-3 flex flex-col gap-1"><div data-slot="card-title" class="text-base font-semibold leading-snug" style="color: var(--text); letter-spacing: -0.01em;">Evaluación de metas</div><p class="text-xs mt-1" style="color: var(--mut);">Evaluación: 12 jul 2026, 05:00 p.m.</p></div><div data-slot="card-content"><div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3"><div class="flex flex-col items-start gap-1 min-w-[7rem]"><div role="status" aria-label="Tasa de filtración glomerular estimada (eGFR): En meta, 72 ml/min/1.73m²" class="inline-flex flex-col items-start gap-1 rounded-lg px-3 py-2 w-full" style="color: var(--ok); background: var(--ok-bg); border: 1px solid; border-width: var(--ok); border-style: var(--ok); border-color: var(--ok);"><span class="text-sm font-semibold break-words" style="color: var(--text);">Tasa de filtración glomerular estimada (eGFR)</span><div class="flex items-baseline gap-1.5"><span class="text-base font-semibold tabular-nums" style="color: var(--ok);">72</span><span class="text-xs font-medium" style="color: var(--ok);">ml/min/1.73m²</span></div><span class="text-xs font-semibold uppercase tracking-wide">En meta</span></div></div><div class="flex flex-col items-start gap-1 min-w-[7rem]"><div role="status" aria-label="HbA1c: En meta, 6.4 %" class="inline-flex flex-col items-start gap-1 rounded-lg px-3 py-2 w-full" style="color: var(--ok); background: var(--ok-bg); border: 1px solid; border-width: var(--ok); border-style: var(--ok); border-color: var(--ok);"><span class="text-sm font-semibold break-words" style="color: var(--text);">HbA1c</span><div class="flex items-baseline gap-1.5"><span class="text-base font-semibold tabular-nums" style="color: var(--ok);">6.4</span><span class="text-xs font-medium" style="color: var(--ok);">%</span></div><span class="text-xs font-semibold uppercase tracking-wide">En meta</span></div></div></div></div></div><div data-slot="card" class="rounded-2xl border" style="background: var(--card); border-color: var(--card-bd); color: var(--text); font-family: Sora, sans-serif; padding: 20px;"><div data-slot="card-header" class="mb-3 flex flex-col gap-1"><div class="flex items-start gap-3"><div class="flex items-center justify-center size-9 rounded-full shrink-0" style="background: var(--info);"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-info size-5" style="color: #fff;" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg></div><div class="flex-1"><div data-slot="card-title" class="text-base font-semibold leading-snug" style="color: var(--text); letter-spacing: -0.01em;">Etapa de enfermedad renal (KDIGO 2024)</div><p class="text-sm mt-1" style="color: var(--text);">Tu eGFR de <strong>72 ml/min/1.73m²</strong> corresponde a la <strong>G2 — Daño renal leve</strong>.</p></div></div></div><div data-slot="card-content"><div class="space-y-2"><div data-testid="ckd-stage-row" data-stage="G1" data-current="false" class="rounded-md border p-3 transition-colors" style="background: var(--card); border-color: var(--bd);"><div class="flex items-baseline justify-between gap-3"><p class="text-sm font-semibold" style="color: var(--text);">G1 — Función renal normal o alta</p><p class="text-xs shrink-0" style="color: var(--mut);">≥ 90 ml/min/1.73m²</p></div><p class="text-xs mt-1 leading-snug" style="color: var(--text);"><span class="font-medium">Acción:</span> Función preservada. Mantener control glucémico y de presión arterial; revisión anual.</p></div><div data-testid="ckd-stage-row" data-stage="G2" data-current="true" class="rounded-md border p-3 transition-colors" style="background: var(--ok-bg); border-color: var(--ok);"><div class="flex items-baseline justify-between gap-3"><p class="text-sm font-semibold" style="color: var(--ok);">G2 — Daño renal leve</p><p class="text-xs shrink-0" style="color: var(--ok);">60–89 ml/min/1.73m²</p></div><p class="text-xs mt-1 leading-snug" style="color: var(--text);"><span class="font-medium">Acción:</span> Daño leve con filtrado aún normal. Optimizar control de glucemia y PA; evaluar causa si hay proteinuria.</p></div><div data-testid="ckd-stage-row" data-stage="G3a" data-current="false" class="rounded-md border p-3 transition-colors" style="background: var(--card); border-color: var(--bd);"><div class="flex items-baseline justify-between gap-3"><p class="text-sm font-semibold" style="color: var(--text);">G3a — Daño renal leve a moderado</p><p class="text-xs shrink-0" style="color: var(--mut);">45–59 ml/min/1.73m²</p></div><p class="text-xs mt-1 leading-snug" style="color: var(--text);"><span class="font-medium">Acción:</span> Requiere nefroprotección activa: iSGLT2, control estricto de PA y glucemia. Vigilancia cada 6 meses.</p></div><div data-testid="ckd-stage-row" data-stage="G3b" data-current="false" class="rounded-md border p-3 transition-colors" style="background: var(--card); border-color: var(--bd);"><div class="flex items-baseline justify-between gap-3"><p class="text-sm font-semibold" style="color: var(--text);">G3b — Daño renal moderado a severo</p><p class="text-xs shrink-0" style="color: var(--mut);">30–44 ml/min/1.73m²</p></div><p class="text-xs mt-1 leading-snug" style="color: var(--text);"><span class="font-medium">Acción:</span> Valorar derivación a nefrología. Ajustar dosis de medicamentos nefrotóxicos; mantener iSGLT2 si se tolera.</p></div><div data-testid="ckd-stage-row" data-stage="G4" data-current="false" class="rounded-md border p-3 transition-colors" style="background: var(--card); border-color: var(--bd);"><div class="flex items-baseline justify-between gap-3"><p class="text-sm font-semibold" style="color: var(--text);">G4 — Daño renal severo</p><p class="text-xs shrink-0" style="color: var(--mut);">15–29 ml/min/1.73m²</p></div><p class="text-xs mt-1 leading-snug" style="color: var(--text);"><span class="font-medium">Acción:</span> Manejo conjunto con nefrología. Preparar acceso vascular para posible terapia de reemplazo renal.</p></div><div data-testid="ckd-stage-row" data-stage="G5" data-current="false" class="rounded-md border p-3 transition-colors" style="background: var(--card); border-color: var(--bd);"><div class="flex items-baseline justify-between gap-3"><p class="text-sm font-semibold" style="color: var(--text);">G5 — Falla renal</p><p class="text-xs shrink-0" style="color: var(--mut);">&lt; 15 ml/min/1.73m²</p></div><p class="text-xs mt-1 leading-snug" style="color: var(--text);"><span class="font-medium">Acción:</span> Terapia de reemplazo renal (diálisis o trasplante). Seguimiento conjunto con nefrología.</p></div></div></div></div></div><div class="mt-12 pt-6 border-t text-center text-sm" style="border-color: var(--bd); color: var(--mut);"><p>Valores de referencia basados en los estándares de atención médica de la ADA (Standards of Care 2026).</p></div></div>"`;
